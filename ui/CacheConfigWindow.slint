// One-window Slint page split from the original monolithic file.
import { ProductButton } from "design-system.slint";
import { Button, ComboBox, LineEdit, CheckBox, TabWidget, ListView, ScrollView, VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";
import { ByteCell, SimRow, MsgRow, SigRow, TxSigRow, TxRow, PbFileRow, TreeRow, ChanStat, IdStat, ChartSeries, DbcSignalRow, SignalPickRow, I18n, Theme, ColW, Cell, HCell, SortHeader, TBtn, Icon, RibbonBtn, RibbonGroup, RibbonTab, ConvTab, SimGlyph, ThemedWindow } from "common.slint";

export component CacheConfigWindow inherits ThemedWindow {
    title: I18n.en ? "Cache Settings" : "缓存设置";
    icon: @image-url("logo.svg");
    preferred-width: 480px;
    preferred-height: 280px;
    min-width: 440px;
    min-height: 260px;
    background: Theme.bg;

    in-out property <string> trace-cap: "100000";
    in-out property <string> chart-cap: "100000";
    callback apply-cache(string, string);
    callback cancel();

    VerticalLayout {
        padding: 16px; spacing: 12px;
        Text { text: I18n.en ? "Adjust cache limits — balance history depth vs memory/smoothness" : "调整缓存上限，平衡历史深度与内存/流畅度"; font-size: Theme.fs; font-weight: 700; color: Theme.text; }
        GridLayout {
            spacing: 10px;
            Row {
                Text { text: I18n.en ? "Raw frame cache (frames)" : "报文原始缓存(帧)"; font-size: 14px; vertical-alignment: center; }
                LineEdit { text: root.trace-cap; width: 180px; edited(v) => { root.trace-cap = v; } }
            }
            Row {
                Text { text: I18n.en ? "Chart points / signal" : "曲线点数 / 信号"; font-size: 14px; vertical-alignment: center; }
                LineEdit { text: root.chart-cap; width: 180px; edited(v) => { root.chart-cap = v; } }
            }
        }
        Rectangle { vertical-stretch: 1;
            Text {
                text: I18n.en ? "100k raw frames ≈ 15–25MB RAM. Charts retain 100k points per signal by default; playback keeps the complete loaded history. Rendering is optimized to the plot width while preserving peaks." : "10 万帧原始缓存约占 15–25MB。曲线每个信号默认保留 10 万点；文件回放会完整保留已载入历史。绘图按窗口宽度优化，并保留峰值/谷值。";
                x: 2px; y: 4px; width: parent.width - 4px; color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
            }
        }
        Rectangle {
            height: 36px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                ProductButton { text: I18n.en ? "Apply" : "应用"; clicked => { root.apply-cache(root.trace-cap, root.chart-cap); } }
                ProductButton { text: I18n.en ? "Cancel" : "取消"; clicked => { root.cancel(); } }
            }
        }
    }
}
