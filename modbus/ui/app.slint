    // =====================================================================
    // Offline authorization dialog
    // =====================================================================
    ProductModal {
        open: root.license-open;
        close-requested => { root.license-open = false; }
        width: 100%;
        height: 100%;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.license-open = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2 + 4px;
            y: (parent.height - self.height) / 2 + 6px;
            width: 540px;
            height: 430px;
            border-radius: 12px;
            background: Theme.shadow;
        }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 540px;
            dialog-height: 430px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            TouchArea { }
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 88px;
                    background: Theme.header;
                    border-radius: 11px;
                    Rectangle {
                        y: parent.height - 11px;
                        width: 100%;
                        height: 11px;
                        background: Theme.header;
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: ProductDesign.on-brand-border;
                    }
                    Text {
                        x: 24px;
                        y: 14px;
                        width: 340px;
                        height: 30px;
                        text: I18n.t("Modbus 使用授权", "Modbus License");
                        color: Theme.accent-fg;
                        font-size: ProductDesign.font-xl;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 24px;
                        y: 45px;
                        width: 380px;
                        height: 24px;
                        text: root.license-unlocked
                            ? I18n.t("本次运行已解除时间限制", "Time limit removed for this session")
                            : I18n.t("剩余使用时间", "Time remaining");
                        color: Theme.accent-fg-muted;
                        font-size: ProductDesign.font-sm;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 132px;
                        y: 23px;
                        width: 104px;
                        height: 40px;
                        border-radius: 8px;
                        background: ProductDesign.on-brand-faint;
                        Text {
                            text: root.license-unlocked ? I18n.t("已授权", "Licensed") : root.license-remaining;
                            color: Theme.accent-fg;
                            font-family: ProductDesign.font-mono;
                            font-size: 18px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 12px;

                    Text {
                        height: 38px;
                        text: I18n.t(
                            "未授权版本可试用一年。将机器码提供给授权方，并导入收到的 Ed25519 签名 .pcanlic 文件。",
                            "The unlicensed edition runs for one year. Send the machine code to the licensor, then import the signed Ed25519 .pcanlic file."
                        );
                        color: Theme.text-muted;
                        font-size: ProductDesign.font-sm;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    Text {
                        height: 20px;
                        text: I18n.t("机器码", "Machine code");
                        font-size: ProductDesign.font-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        height: ProductDesign.control-height;
                        spacing: 8px;
                        LineEdit {
                            text: root.license-machine-code;
                            read-only: true;
                            font-family: ProductDesign.font-mono;
                        }
                        ProductButton {
                            width: 112px;
                            text: I18n.t("复制机器码", "Copy code");
                            clicked => { root.license-copy-machine-code(); }
                        }
                    }

                    Text {
                        height: 20px;
                        text: I18n.t("离线授权文件", "Offline license file");
                        font-size: ProductDesign.font-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 54px;
                        border-width: 1px;
                        border-color: ProductDesign.border;
                        border-radius: 7px;
                        background: ProductDesign.surface-raised;
                        VerticalLayout {
                            x: 12px;
                            width: parent.width - 24px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 1px;
                            Text {
                                text: root.license-info != "" ? root.license-info : I18n.t("请选择 .pcanlic 文件", "Select a .pcanlic file");
                                color: root.license-info != "" ? ProductDesign.text : Theme.text-muted;
                                font-size: ProductDesign.font-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                visible: root.license-unlocked;
                                text: I18n.en ? root.license-validity-en : root.license-validity-zh;
                                color: Theme.ok;
                                font-size: ProductDesign.font-xs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Text {
                        height: 22px;
                        text: root.license-error;
                        color: root.license-unlocked ? Theme.ok : Theme.err;
                        font-size: ProductDesign.font-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        height: ProductDesign.control-height;
                        spacing: 10px;
                        ProductButton {
                            text: I18n.t("关闭", "Close");
                            clicked => { root.license-open = false; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        AccentButton {
                            width: 132px;
                            enabled: !root.license-unlocked;
                            text: I18n.t("导入授权文件", "Import license");
                            clicked => { root.license-import(); }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Floating poll monitor — a separate top-level window mirroring one poll
// window's live state, so several polls can be watched at once.
// ---------------------------------------------------------------------------
export component PollFloat inherits Window {
    title: "Modbus Poll — " + root.ptitle;
    preferred-width: 740px;
    preferred-height: 480px;
    min-width: 460px;
    min-height: 440px; // 底部 log/chart 固定占高较大, 提高最小高度防裁剪

    in property <string> ptitle: "Poll";
    in property <[RegRow]> rows;
    in property <[string]> names;
    in property <string> status: "";
    in property <int> tx: 0;
    in property <int> rx: 0;
    in property <int> err: 0;
    in property <[LogLine]> log;
    in property <[LogLine]> traffic;
    in property <[MiniChart]> charts;
    in property <bool> chart-has: false;
    in-out property <[ChartSeries]> series;
    in-out property <string> axis-lmin;
    in-out property <string> axis-lmax;
    in-out property <string> axis-rmin;
    in-out property <string> axis-rmax;
    in-out property <bool> chart-has-right: false;
    in-out property <bool> chart-overlay: true;
    callback chart-axis(int, int);
    in property <string> fc-text: "FC 03 · Read Holding Registers";
    in property <bool> is-write: false;
    in-out property <int> bottom-tab: 0;

    VerticalLayout {
        Rectangle {
            height: 38px;
            background: Theme.accent;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Rectangle {
                    width: 52px; height: 20px; border-radius: 4px; background: Theme.accent-fg;
                    y: (parent.height - self.height) / 2;
                    Text { text: I18n.t("客户端", "CLIENT"); color: Theme.accent; font-size: 10px; font-weight: 800; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.ptitle; color: Theme.accent-fg; font-size: 15px; font-weight: 800; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Tx: \{root.tx}"; color: Theme.accent-fg; vertical-alignment: center; }
                Text { text: "Rx: \{root.rx}"; color: Theme.accent-fg; vertical-alignment: center; }
                Text { text: "Err: \{root.err}"; color: Theme.accent-fg; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            // function-code indicator (mirrors the main window's)
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: root.is-write ? Theme.warn.with-alpha(0.16) : Theme.accent.with-alpha(0.14);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 50px;
                        height: 20px;
                        border-radius: 4px;
                        background: root.is-write ? Theme.warn : Theme.accent;
                        y: (parent.height - self.height) / 2;
                        Text {
                            text: root.is-write ? I18n.t("写入", "WRITE") : I18n.t("读取", "READ");
                            color: Theme.accent-fg; font-size: ProductDesign.font-xs; font-weight: 800;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text { text: root.fc-text; vertical-alignment: center; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            DataGrid {
                vertical-stretch: 1;
                rows: root.rows;
                names: root.names;
                values-editable: false;
            }
            Rectangle {
                height: 30px;
                border-radius: 8px;
                background: ProductDesign.surface;
                border-width: 1px;
                border-color: ProductDesign.border;
                Text { x: 12px; width: parent.width - 24px; height: 100%; text: root.status; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}

// Floating server monitor — its own table/address/quantity view into the SAME
// shared data store. Multiple monitors can watch different tables at once.
export component SlaveMonitor inherits Window {
    title: "Modbus Server — " + root.mtitle;
    preferred-width: 520px;
    preferred-height: 470px;
    min-width: 440px;
    min-height: 440px;
    icon: @image-url("logo.svg");

    in property <string> mtitle: "Monitor";
    in property <string> ident;         // 识别信息: bind 地址 · Unit ID
    in property <[RegRow]> rows;
    in property <[string]> names;
    in property <string> status: "";
    in property <[LogLine]> log;
    in property <[LogLine]> traffic;
    in property <int> requests: 0;
    in property <bool> running: false;
    in-out property <int> addr-mode: 0;
    in-out property <length> grid-font: 14px;
    in-out property <int> bottom-tab: 0;
    callback edit(int, string);

    VerticalLayout {
        // 统一顶部标题条(SERVER 识别色)
        Rectangle {
            height: 38px;
            background: Theme.ok;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Rectangle {
                    width: 56px; height: 20px; border-radius: 4px; background: Theme.accent-fg;
                    y: (parent.height - self.height) / 2;
                    Text { text: I18n.t("服务端", "SERVER"); color: Theme.ok; font-size: 10px; font-weight: 800; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.mtitle; color: Theme.accent-fg; font-size: 15px; font-weight: 800; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Requests: \{root.requests}"; color: Theme.accent-fg; vertical-alignment: center; }
                Rectangle {
                    width: 10px; height: 10px; border-radius: 5px;
                    y: (parent.height - self.height) / 2;
                    background: root.running ? Theme.accent-fg : Theme.accent-fg-subtle;
                }
            }
        }
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            // 识别信息条(镜像主页 Memory view —— 编辑可写回共享存储)
            Rectangle {
                height: 26px;
                border-radius: 6px;
                background: Theme.ok.with-alpha(0.14);
                Text { x: 12px; width: parent.width - 24px; height: 100%; text: root.ident; vertical-alignment: center; font-weight: 600; overflow: elide; }
            }
            DataGrid {
                vertical-stretch: 1;
                rows: root.rows;
                names: root.names;
                values-editable: true;
                addr-mode <=> root.addr-mode;
                grid-font: root.grid-font;
                edit(addr, txt) => { root.edit(addr, txt); }
            }
            // 底部状态行
            Rectangle {
                height: 30px;
                border-radius: 8px;
                background: ProductDesign.zebra;
                border-width: 1px;
                border-color: ProductDesign.border;
                Text { x: 12px; width: parent.width - 24px; height: 100%; text: root.status; vertical-alignment: center; overflow: elide; font-size: ProductDesign.font-sm; }
            }
        }
    }
}
