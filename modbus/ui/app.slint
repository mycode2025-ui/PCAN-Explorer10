import { Button, ComboBox, LineEdit, SpinBox, ListView, ScrollView, CheckBox, TextEdit, Palette } from "std-widgets.slint";
import { ProductDesign, ProductDensitySwitch, ProductDialogSurface, ProductModal, ProductButton, ProductHeaderButton, ProductHeaderCheck, ProductI18n, ProductLanguageSwitch, ProductStatusDot, ProductThemeSwitch } from "../../ui/design-system.slint";

export global I18n {
    in-out property <bool> en: ProductI18n.en;
    changed en => { ProductI18n.en = en; }
    public pure function t(zh: string, eng: string) -> string {
        return ProductI18n.t(zh, eng);
    }
}

// ---------------------------------------------------------------------------
// Shared data structures (generated into Rust as RegRow / LogLine / MiniChart)
// ---------------------------------------------------------------------------
export struct RegRow {
    address: int,
    name: string,
    value: string,
    raw: string,
    editable: bool,
    colored: bool,
    vcolor: color,
    hex-addr: string,
    plc-addr: string,
    auto-inc: bool,
}

export struct LogLine {
    time: string,
    dir: string,
    text: string,
}

// One row of the client Write List grid (address is derived: start + index).
export struct WriteRow {
    value: string,
    auto: bool,
}

// One per-register mini chart (its own auto-scaled Y range).
export struct MiniChart {
    name: string,
    linecolor: color,
    commands: string,
    ymin: string,
    ymax: string,
}

// One series for the combined/overlay chart. `commands` is an SVG path string in
// a fixed coordinate space (x 0..1000 = full sample range, y 0..300 within the
// series' axis range). The UI pans/zooms purely by moving the Path viewbox.
export struct ChartSeries {
    name: string,
    addr: int,
    color: color,
    axis: int,        // 0 = left Y axis, 1 = right Y axis
    commands: string,
}

export struct WinTab {
    id: int,
    title: string,
    connected: bool,
}

// A server view "window" (tab) — its own table/address/quantity/format into the
// shared store, mirroring the client's poll-window tabs.
export struct SlaveWinTab {
    id: int,
    title: string,
    area: int,
    address: int,
    quantity: int,
    format: int,
}

global Fmt {
    out property <[string]> list: [
        "Signed", "Unsigned", "Hex", "Binary", "ASCII-Hex",
        "32-bit Signed (ABCD)", "32-bit Signed (CDAB)", "32-bit Signed (BADC)", "32-bit Signed (DCBA)",
        "32-bit Unsigned (ABCD)", "32-bit Unsigned (CDAB)", "32-bit Unsigned (BADC)", "32-bit Unsigned (DCBA)",
        "32-bit Float (ABCD)", "32-bit Float (CDAB)", "32-bit Float (BADC)", "32-bit Float (DCBA)",
        "64-bit Signed (ABCD)", "64-bit Signed (CDAB)", "64-bit Signed (BADC)", "64-bit Signed (DCBA)",
        "64-bit Unsigned (ABCD)", "64-bit Unsigned (CDAB)", "64-bit Unsigned (BADC)", "64-bit Unsigned (DCBA)",
        "64-bit Double (ABCD)", "64-bit Double (CDAB)", "64-bit Double (BADC)", "64-bit Double (DCBA)",
    ];
    out property <[string]> ops: ["(none)", "=", ">", "<", ">=", "<=", "AND"];
    out property <[string]> palette: ["Default", "Red", "Green", "Yellow", "Blue", "Orange", "Cyan", "Magenta"];
}

// Scientific-blue theme palette (overrides the OS accent colour).
global Theme {
    in-out property <bool> dark: ProductDesign.dark;
    changed dark => { ProductDesign.dark = dark; }
    out property <color> window: ProductDesign.window;
    out property <color> toolbar: ProductDesign.surface;
    out property <color> header: ProductDesign.brand-header;
    out property <color> accent: ProductDesign.brand;
    out property <color> accent-2: ProductDesign.brand-hover;
    out property <color> accent-soft: ProductDesign.brand-soft;
    out property <color> accent-fg: ProductDesign.on-brand;
    out property <color> accent-fg-muted: ProductDesign.on-brand-muted;
    out property <color> accent-fg-strong: ProductDesign.on-brand-strong;
    out property <color> accent-fg-subtle: ProductDesign.on-brand-subtle;
    out property <color> ok: ProductDesign.success;
    out property <color> warn: ProductDesign.warning;
    out property <color> err: ProductDesign.danger;
    out property <color> info: ProductDesign.info;
    out property <color> text-muted: ProductDesign.text-muted;
    out property <color> scrim: ProductDesign.scrim;
    out property <color> shadow: ProductDesign.shadow-strong;
}

// A filled accent (blue) action button, independent of the OS accent colour.
component AccentButton inherits ProductButton { primary: true; }

component ToolBar inherits Rectangle {
    height: 44px;
    border-radius: ProductDesign.radius-sm;
    background: ProductDesign.header-surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    @children
}

// Shared master/server toolbar action. Fixed geometry avoids native-style
// preferred-height differences and keeps both role toolbars visually identical.
component ToolAction inherits ProductButton {
    in property <length> action-width: 92px;
    width: root.action-width;
    h: ProductDesign.toolbar-control-height;
}

// A modern segmented switch (sliding white thumb on a translucent track).
component ModeSwitch inherits Rectangle {
    in property <string> left-text;
    in property <string> right-text;
    in property <length> fixed-width: 280px;
    in-out property <int> selected; // 0 = left, 1 = right
    width: root.fixed-width;
    height: 38px;
    border-radius: self.height / 2;
    accessible-role: AccessibleRole.button;
    accessible-label: root.selected == 0 ? root.left-text : root.right-text;
    forward-focus: key-focus;
    accessible-action-default => { root.selected = root.selected == 0 ? 1 : 0; }
    background: Theme.dark ? ProductDesign.brand-soft : ProductDesign.on-brand-faint;
    border-width: key-focus.has-focus ? ProductDesign.focus-width : 1px;
    border-color: key-focus.has-focus ? Theme.warn : (Theme.dark ? ProductDesign.border : ProductDesign.on-brand-border);

    // sliding highlight thumb
    Rectangle {
        width: parent.width / 2 - 8px;
        height: parent.height - 8px;
        y: 4px;
        x: root.selected == 0 ? 4px : (parent.width / 2 + 4px);
        border-radius: self.height / 2;
        background: Theme.dark ? ProductDesign.selection : Theme.accent-fg;
        animate x { duration: 160ms; easing: ease-in-out; }
    }

    // left segment
    Rectangle {
        x: 0;
        width: parent.width / 2;
        height: 100%;
        Text {
            text: root.left-text;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: ProductDesign.body-font-size;
            font-weight: 700;
            color: Theme.dark
                ? (root.selected == 0 ? Theme.accent-fg : Theme.accent-fg-muted)
                : (root.selected == 0 ? Theme.accent : Theme.accent-fg);
        }
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.selected = 0; }
        }
    }

    // right segment
    Rectangle {
        x: parent.width / 2;
        width: parent.width / 2;
        height: 100%;
        Text {
            text: root.right-text;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: ProductDesign.body-font-size;
            font-weight: 700;
            color: Theme.dark
                ? (root.selected == 1 ? Theme.accent-fg : Theme.accent-fg-muted)
                : (root.selected == 1 ? Theme.accent : Theme.accent-fg);
        }
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.selected = 1; }
        }
    }
    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.selected = 0;
                return accept;
            } else if event.text == Key.RightArrow {
                root.selected = 1;
                return accept;
            } else if event.text == Key.Return || event.text == " " {
                root.selected = root.selected == 0 ? 1 : 0;
                return accept;
            }
            return reject;
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    height: ProductDesign.form-control-height;
    spacing: 4px;
    Text {
        width: ProductDesign.form-label-width;
        text: root.label;
        vertical-alignment: center;
        horizontal-alignment: left;
        wrap: word-wrap;
        opacity: 0.8;
    }
    Rectangle {
        min-width: 0px;
        horizontal-stretch: 1;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            @children
        }
    }
}

// ---------------------------------------------------------------------------
// Data grid with editable Name column, conditional-colour values, hex-addr
// toggle, row selection highlight and right-click context menu.
// ---------------------------------------------------------------------------
component DataGrid inherits Rectangle {
    in property <[RegRow]> rows;
    in property <[string]> names;
    in property <bool> values-editable;
    in-out property <int> addr-mode: 0;   // 0=Dec, 1=Hex, 2=PLC(base-1)
    in property <bool> addr-in-cell: false;
    in property <length> grid-font: 14px;
    in-out property <int> selected-row: -1;

    // address text for row i, honouring addr-mode (derived rows show "fx")
    pure function addr-text(i: int) -> string {
        if i >= root.rows.length { return ""; }
        if root.rows[i].address < 0 { return root.rows[i].hex-addr; }
        if root.addr-mode == 1 { return root.rows[i].hex-addr; }
        if root.addr-mode == 2 { return root.rows[i].plc-addr; }
        return "\{root.rows[i].address}";
    }
    callback edit(int, string);
    callback name-edit(int, string);
    callback activate(int);
    callback row-copy(int);
    callback row-delete(int);
    callback row-chart(int);
    callback row-format(int);
    callback row-autoinc(int);
    in property <bool> allow-autoinc: false;

    border-radius: 8px;
    background: ProductDesign.surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    clip: true;

    in-out property <bool> menu-open: false;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <int> menu-row: -1;

    VerticalLayout {
        Rectangle {
            height: ProductDesign.form-control-height;
            background: ProductDesign.zebra;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text { width: 132px; text: I18n.t("名称", "Name"); vertical-alignment: center; font-weight: 700; }
                Rectangle {
                    width: 70px;
                    addr-hdr-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.addr-mode = Math.mod(root.addr-mode + 1, 3); }
                    }
                    Text {
                        text: root.addr-mode == 1 ? I18n.t("地址(H)", "Addr(H)") : root.addr-mode == 2 ? I18n.t("地址(P)", "Addr(P)") : I18n.t("地址", "Address");
                        vertical-alignment: center; font-weight: 700;
                        color: addr-hdr-ta.has-hover ? Theme.accent : ProductDesign.text;
                    }
                }
                Text { horizontal-stretch: 1; text: I18n.t("数值", "Value"); vertical-alignment: center; font-weight: 700; }
                Text { width: 92px; text: I18n.t("原始值（十六进制）", "Raw (hex)"); vertical-alignment: center; font-weight: 700; }
            }
        }
        ListView {
            for name[i] in root.names: Rectangle {
                height: 30px;
                background:
                    i == root.selected-row ? Theme.accent-soft :
                    (Math.mod(i, 2) == 0 ? transparent : ProductDesign.zebra);
                row-ta := TouchArea {
                    width: 100%; height: 100%;
                    clicked => { root.selected-row = i; }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.selected-row = i;
                            root.menu-row = i;
                            // 行内局部坐标 → DataGrid 根坐标(否则菜单永远画在 grid 顶部), 再 clamp 防溢出边界
                            root.menu-x = Math.max(0px, Math.min(
                                self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                                root.width - 168px));
                            root.menu-y = Math.max(0px, Math.min(
                                self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                                root.height - ((root.allow-autoinc ? 6 : 5) * 30px + 2px)));
                            root.menu-open = true;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    ne := LineEdit {
                        width: 132px;
                        text: name;
                        placeholder-text: "—";
                        // 失焦/回车时才提交(打字时不碰模型, 否则后端重渲染会替换整列名字→输入框失焦)
                        accepted => { root.name-edit(i < root.rows.length ? root.rows[i].address : i, self.text); }
                        changed has-focus => {
                            if (!ne.has-focus) {
                                root.name-edit(i < root.rows.length ? root.rows[i].address : i, self.text);
                            }
                        }
                    }
                    Text {
                        width: 70px;
                        text: root.addr-text(i);
                        vertical-alignment: center; font-weight: 600;
                        font-size: root.grid-font;
                    }
                    if !root.values-editable: Rectangle {
                        horizontal-stretch: 1;
                        val-ta := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { if i < root.rows.length { root.activate(root.rows[i].address); } }
                        }
                        HorizontalLayout {
                            Text {
                                text: i < root.rows.length ? ((root.addr-in-cell ? root.addr-text(i) + " = " : "") + root.rows[i].value) : "";
                                vertical-alignment: center;
                                font-size: root.grid-font;
                                color: i < root.rows.length ? (root.rows[i].colored ? root.rows[i].vcolor : (val-ta.has-hover ? Theme.accent : ProductDesign.text)) : ProductDesign.text;
                                font-weight: i < root.rows.length ? (root.rows[i].colored ? 700 : 400) : 400;
                            }
                        }
                    }
                    if root.values-editable: LineEdit {
                        horizontal-stretch: 1;
                        text: i < root.rows.length ? root.rows[i].value : "";
                        accepted => { if i < root.rows.length { root.edit(root.rows[i].address, self.text); } }
                    }
                    Text { width: 92px; text: i < root.rows.length ? root.rows[i].raw : ""; vertical-alignment: center; opacity: 0.55; font-size: root.grid-font; }
                }
            }
        }
    }

    // ---- context menu (declared LAST so it renders above the grid rows) ----
    if root.menu-open: TouchArea {
        width: 100%; height: 100%;
        clicked => { root.menu-open = false; }
    }
    if root.menu-open: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 168px;
        height: (root.allow-autoinc ? 6 : 5) * 30px + 2px;
        border-radius: 6px;
        background: ProductDesign.surface;
        border-width: 1px;
        border-color: ProductDesign.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        VerticalLayout {
            spacing: 0;
            for item[idx] in ["Write", "Set format…", "Copy value", "Delete row", "Show chart"]: Rectangle {
                height: 30px;
                background: item-ta.has-hover ? ProductDesign.zebra : ProductDesign.surface;
                item-ta := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.menu-open = false;
                        if root.menu-row >= 0 && root.menu-row < root.rows.length {
                            if idx == 0 { root.activate(root.rows[root.menu-row].address); }
                            if idx == 1 { root.row-format(root.rows[root.menu-row].address); }
                            if idx == 2 { root.row-copy(root.rows[root.menu-row].address); }
                            if idx == 3 { root.row-delete(root.rows[root.menu-row].address); }
                            if idx == 4 { root.row-chart(root.rows[root.menu-row].address); }
                        }
                    }
                }
                Text {
                    x: 12px; height: 100%; vertical-alignment: center;
                    text: item;
                }
            }
            if root.allow-autoinc: Rectangle {
                height: 30px;
                background: ai-ta.has-hover ? ProductDesign.zebra : ProductDesign.surface;
                ai-ta := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.menu-open = false;
                        if root.menu-row >= 0 && root.menu-row < root.rows.length {
                            root.row-autoinc(root.rows[root.menu-row].address);
                        }
                    }
                }
                Text {
                    x: 12px; height: 100%; vertical-alignment: center;
                    text: (root.menu-row >= 0 && root.menu-row < root.rows.length && root.rows[root.menu-row].auto-inc ? "● " : "    ") + "Auto-increment";
                }
            }
        }
    }
}

component LogPanel inherits Rectangle {
    in property <[LogLine]> lines;
    border-radius: 8px;
    background: ProductDesign.surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    clip: true;

    ListView {
        for l in root.lines: Rectangle {
            height: 22px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text { width: 64px; text: l.time; opacity: 0.55; }
                Text {
                    width: 34px;
                    text: l.dir;
                    font-weight: 800;
                    color: l.dir == "ERR" ? Theme.err : (l.dir == "Tx" || l.dir == "TX" ? Theme.info : (l.dir == "…" ? Theme.warn : Theme.ok));
                }
                Text { horizontal-stretch: 1; text: l.text; overflow: elide; }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// One register's own mini chart (auto-scaled to its own Y range).
// ---------------------------------------------------------------------------
component ChartCard inherits Rectangle {
    in property <MiniChart> mc;
    height: 92px;
    border-radius: 8px;
    background: ProductDesign.surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        VerticalLayout {
            width: 96px;
            Text { text: root.mc.name; font-weight: 700; color: root.mc.linecolor; }
            Text { text: root.mc.ymax; font-size: ProductDesign.font-xs; opacity: 0.6; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.mc.ymin; font-size: ProductDesign.font-xs; opacity: 0.6; }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: ProductDesign.zebra;
            border-radius: 4px;
            clip: true;
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 1000;
                viewbox-height: 300;
                commands: root.mc.commands;
                stroke: root.mc.linecolor;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }
}

// A scrolling stack of per-register mini charts.
component ChartGrid inherits Rectangle {
    in property <[MiniChart]> charts;
    in property <bool> has-data;
    border-radius: 8px;
    background: ProductDesign.surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    clip: true;

    if !root.has-data: Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: I18n.t("暂无曲线数据——请连接并轮询数值寄存器。", "No chart data yet — connect and poll numeric registers.");
        opacity: 0.5;
    }
    ScrollView {
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            for c in root.charts: ChartCard { mc: c; }
        }
    }
}

// Combined / overlay chart with dual Y axes and X pan+zoom. Each series'
// samples arrive pre-normalised to [0,1] within its axis range, so this only
// maps the X (sample) axis through the interactive view window.
component OverlayChart inherits Rectangle {
    in property <[ChartSeries]> series;
    in property <string> axis-lmin;
    in property <string> axis-lmax;
    in property <string> axis-rmin;
    in property <string> axis-rmax;
    in property <bool> has-right;
    callback axis-toggle(int, int);   // (addr, new-axis)

    property <float> view-start: 0;   // left edge as fraction [0,1] of samples
    property <float> view-span: 1.0;  // visible fraction (zoom)

    border-radius: 8px;
    background: ProductDesign.surface;
    border-width: 1px;
    border-color: ProductDesign.border;
    clip: true;

    if root.series.length == 0: Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: I18n.t("暂无曲线数据——请连接并轮询数值寄存器。", "No chart data yet — connect and poll numeric registers.");
        opacity: 0.5;
    }

    if root.series.length > 0: VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // ---- toolbar ----
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            ProductButton {
                text: "+";
                clicked => {
                    root.view-start = Math.max(0, Math.min(1 - root.view-span * 0.7, (root.view-start + root.view-span / 2) - root.view-span * 0.7 / 2));
                    root.view-span = Math.max(0.02, root.view-span * 0.7);
                }
            }
            ProductButton {
                text: "−";
                clicked => {
                    root.view-start = Math.max(0, Math.min(1 - Math.min(1.0, root.view-span / 0.7), (root.view-start + root.view-span / 2) - Math.min(1.0, root.view-span / 0.7) / 2));
                    root.view-span = Math.min(1.0, root.view-span / 0.7);
                }
            }
            ProductButton { text: I18n.t("复位", "Reset"); clicked => { root.view-start = 0; root.view-span = 1.0; } }
            ProductButton { text: I18n.t("最新", "Latest"); clicked => { root.view-start = 1 - root.view-span; } }
            Text { text: I18n.t("拖动平移 · 滚轮缩放 · 点击图例切换坐标轴", "drag = pan · wheel = zoom · click legend = swap axis"); font-size: ProductDesign.font-xs; opacity: 0.55; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }

        // ---- legend ----
        ScrollView {
            height: 28px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
            viewport-height: 22px;
            HorizontalLayout {
                height: 22px;
                spacing: 6px;
                for s in root.series: Rectangle {
                    width: chip-row.preferred-width + 12px;
                    border-radius: 4px;
                    background: chip-ta.has-hover ? Theme.accent-soft : ProductDesign.zebra;
                    chip-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.axis-toggle(s.addr, s.axis == 0 ? 1 : 0); }
                    }
                    chip-row := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 5px;
                        Rectangle { width: 10px; height: 10px; border-radius: 2px; background: s.color; y: (parent.height - self.height) / 2; }
                        Text { text: s.name + " (" + (s.axis == 1 ? "R" : "L") + ")"; font-size: ProductDesign.font-xs; vertical-alignment: center; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ---- plot row: left axis | plot | right axis ----
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 4px;
            VerticalLayout {
                width: 48px;
                Text { text: root.axis-lmax; font-size: 10px; opacity: 0.7; horizontal-alignment: right; }
                Rectangle { vertical-stretch: 1; }
                Text { text: root.axis-lmin; font-size: 10px; opacity: 0.7; horizontal-alignment: right; }
            }
            plot := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: ProductDesign.zebra;
                border-width: 1px;
                border-color: ProductDesign.border;

                // horizontal gridlines
                for k in 5: Rectangle {
                    y: plot.height * k / 4 - self.height / 2;
                    height: 1px;
                    background: ProductDesign.border;
                    opacity: 0.4;
                }

                // series polylines — pan/zoom by moving the viewbox window over
                // the fixed 0..1000 (x) × 0..300 (y) coordinate space.
                for s in root.series: Path {
                    width: 100%;
                    height: 100%;
                    stroke: s.color;
                    stroke-width: 1.5px;
                    fill: transparent;
                    commands: s.commands;
                    viewbox-x: root.view-start * 1000;
                    viewbox-y: 0;
                    viewbox-width: root.view-span * 1000;
                    viewbox-height: 300;
                }

                ta := TouchArea {
                    mouse-cursor: grab;
                    moved => {
                        if self.pressed {
                            root.view-start = Math.max(0, Math.min(1 - root.view-span,
                                root.view-start - (self.mouse-x - self.pressed-x) / plot.width * root.view-span));
                        }
                    }
                    scroll-event(e) => {
                        root.view-start = Math.max(0, Math.min(1 - root.view-span * (e.delta-y < 0 ? 0.85 : 1.18),
                            (root.view-start + (ta.mouse-x / plot.width) * root.view-span) - (ta.mouse-x / plot.width) * root.view-span * (e.delta-y < 0 ? 0.85 : 1.18)));
                        root.view-span = Math.max(0.02, Math.min(1.0, root.view-span * (e.delta-y < 0 ? 0.85 : 1.18)));
                        accept
                    }
                }
            }
            if root.has-right: VerticalLayout {
                width: 48px;
                Text { text: root.axis-rmax; font-size: 10px; opacity: 0.7; }
                Rectangle { vertical-stretch: 1; }
                Text { text: root.axis-rmin; font-size: 10px; opacity: 0.7; }
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: txt.preferred-width + 24px;
    height: 30px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    forward-focus: key-focus;
    accessible-action-default => { root.clicked(); }
    border-radius: 6px;
    background: root.active ? Theme.accent : transparent;
    border-width: key-focus.has-focus ? ProductDesign.focus-width : 0px;
    border-color: Theme.warn;
    txt := Text {
        text: root.label;
        x: 12px;
        vertical-alignment: center;
        height: 100%;
        color: root.active ? Theme.accent-fg : ProductDesign.text;
        font-weight: root.active ? 700 : 400;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// ---------------------------------------------------------------------------
// 独立 Chart 子窗口(主站)—— 把曲线 + 显示相关功能(Derived/Scaling/Colors/Value
// Names/Export)从主界面拆出来,数据由 Rust 侧定时镜像主窗属性喂入。
// ---------------------------------------------------------------------------
export component MasterChartWindow inherits Window {
    title: "Modbus — Chart";
    icon: @image-url("logo.svg");
    preferred-width: 1000px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 420px;
    background: ProductDesign.surface;

    in property <[ChartSeries]> series;
    in property <[MiniChart]> charts;
    in property <bool> chart-has: false;
    in property <bool> chart-has-right: false;
    in property <string> axis-lmin;
    in property <string> axis-lmax;
    in property <string> axis-rmin;
    in property <string> axis-rmax;
    in property <string> ident;       // 识别信息: Client · 连接目标 · Slave ID
    in property <int> page-start: 0;
    in property <int> series-total: 0;
    in-out property <bool> overlay: true;

    callback axis-toggle(int, int);
    callback page-change(int);
    callback export-chart();
    callback open-derived();
    callback open-scaling();
    callback open-colors();
    callback open-value-names();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        // ---- 识别信息条 (区分这是哪个会话的曲线) ----
        Rectangle {
            height: 28px;
            border-radius: 6px;
            background: Theme.accent.with-alpha(0.14);
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                Rectangle {
                    width: 46px; height: 18px; border-radius: 4px; background: Theme.accent;
                    y: (parent.height - self.height) / 2;
                    Text { text: I18n.t("客户端", "CLIENT"); color: Theme.accent-fg; font-size: 10px; font-weight: 800; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.ident; vertical-alignment: center; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
            }
        }
        ScrollView {
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                ProductButton { text: root.overlay ? "● Overlay" : "Overlay"; clicked => { root.overlay = true; } }
                ProductButton { text: !root.overlay ? "● Grid" : "Grid"; clicked => { root.overlay = false; } }
                Rectangle { width: 16px; }
                ProductButton { text: I18n.t("派生量…", "Derived…"); clicked => { root.open-derived(); } }
                ProductButton { text: I18n.t("缩放…", "Scaling…"); clicked => { root.open-scaling(); } }
                ProductButton { text: I18n.t("颜色…", "Colors…"); clicked => { root.open-colors(); } }
                ProductButton { text: I18n.t("数值名称…", "Value Names…"); clicked => { root.open-value-names(); } }
                Rectangle { width: 12px; }
                ProductButton { text: "<"; enabled: root.page-start > 0; clicked => { root.page-change(-1); } }
                Text {
                    text: root.series-total == 0 ? "0 / 0" : "\{root.page-start + 1}-\{Math.min(root.page-start + 12, root.series-total)} / \{root.series-total}";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 96px;
                }
                ProductButton { text: ">"; enabled: root.page-start + 12 < root.series-total; clicked => { root.page-change(1); } }
                ProductButton { text: I18n.t("导出曲线", "Export Chart"); clicked => { root.export-chart(); } }
            }
        }
        if root.overlay: OverlayChart {
            vertical-stretch: 1;
            series: root.series;
            axis-lmin: root.axis-lmin;
            axis-lmax: root.axis-lmax;
            axis-rmin: root.axis-rmin;
            axis-rmax: root.axis-rmax;
            has-right: root.chart-has-right;
            axis-toggle(addr, ax) => { root.axis-toggle(addr, ax); }
        }
        if !root.overlay: ChartGrid {
            vertical-stretch: 1;
            charts: root.charts;
            has-data: root.chart-has;
        }
    }
}

// ---------------------------------------------------------------------------
// 独立 Chart 子窗口(从站)—— 从站只有 grid 图,按钮 = Scaling/Colors/Value Names。
// ---------------------------------------------------------------------------
export component SlaveChartWindow inherits Window {
    title: "Modbus — Chart (Server)";
    icon: @image-url("logo.svg");
    preferred-width: 1000px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 420px;
    background: ProductDesign.surface;

    in property <[MiniChart]> charts;
    in property <bool> chart-has: false;
    in property <string> ident;       // 识别信息: Server · bind 地址 · Unit ID

    callback open-scaling();
    callback open-colors();
    callback open-value-names();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 28px;
            border-radius: 6px;
            background: Theme.ok.with-alpha(0.16);
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                Rectangle {
                    width: 50px; height: 18px; border-radius: 4px; background: Theme.ok;
                    y: (parent.height - self.height) / 2;
                    Text { text: I18n.t("服务端", "SERVER"); color: Theme.accent-fg; font-size: 10px; font-weight: 800; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.ident; vertical-alignment: center; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
            }
        }
        ScrollView {
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                ProductButton { text: I18n.t("缩放…", "Scaling…"); clicked => { root.open-scaling(); } }
                ProductButton { text: I18n.t("颜色…", "Colors…"); clicked => { root.open-colors(); } }
                ProductButton { text: I18n.t("数值名称…", "Value Names…"); clicked => { root.open-value-names(); } }
            }
        }
        ChartGrid {
            vertical-stretch: 1;
            charts: root.charts;
            has-data: root.chart-has;
        }
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    property <length> page-gap: 12px;
    property <length> connection-width: 300px;
    property <bool> connection-open: true;
    property <bool> narrow: false;
    changed width => {
        root.page-gap = ProductDesign.page-gap(root.width);
        root.connection-width = ProductDesign.sidebar-width(root.width);
        root.connection-open = root.width >= 1050px;
        root.narrow = root.width < 1050px;
    }
    title: "Modbus Tools";
    icon: @image-url("logo.svg");
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.window;
    default-font-family: ProductDesign.font-sans;
    always-on-top: root.topmost-enabled;

    in-out property <int> active-mode: 0;
    in-out property <bool> dark: false;
    in-out property <bool> lang-en: false;
    in-out property <bool> topmost-enabled: false;
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed lang-en => { I18n.en = root.lang-en; }

    // ---- Master config ----
    in-out property <int> m-transport: 0;
    in-out property <string> m-host: "127.0.0.1";
    in-out property <int> m-port: 502;
    // TLS (Modbus/TCP Security) — client
    in-out property <bool> m-tls: false;
    in-out property <string> m-tls-ca;
    in-out property <bool> m-tls-skip: false;
    in-out property <string> m-tls-domain;
    in-out property <string> m-tls-cert;   // client cert (mutual TLS)
    in-out property <string> m-tls-key;    // client key
    in-out property <int> m-tls-cipher: 0; // 0 auto,1 AES-128,2 AES-256,3 ChaCha20
    in-out property <int> m-tls-version: 0; // 0 auto,1 TLS1.2,2 TLS1.3
    callback pick-m-tls-ca();
    callback pick-m-tls-cert();
    callback pick-m-tls-key();
    in-out property <string> m-serial: "COM1";
    in-out property <int> m-baud-index: 0;
    in-out property <int> m-databits-index: 0;
    in-out property <int> m-parity: 0;
    in-out property <int> m-stopbits: 0;
    in-out property <int> m-slave-id: 1;
    in-out property <int> m-function: 2;
    // Human label for the currently selected master function code.
    pure function fc-label(i: int) -> string {
        if i == 0 { return "FC 01 · Read Coils"; }
        if i == 1 { return "FC 02 · Read Discrete Inputs"; }
        if i == 2 { return "FC 03 · Read Holding Registers"; }
        if i == 3 { return "FC 04 · Read Input Registers"; }
        if i == 4 { return "FC 05 · Write Single Coil"; }
        if i == 5 { return "FC 06 · Write Single Register"; }
        if i == 6 { return "FC 15 · Write Multiple Coils"; }
        return "FC 16 · Write Multiple Registers";
    }
    pure function quantity-limit(i: int) -> int {
        if i <= 1 { return 2000; }
        if i <= 3 { return 125; }
        if i <= 5 { return 1; }
        if i == 6 { return 1968; }
        return 123;
    }
    in-out property <int> m-address: 0;
    in-out property <int> m-quantity: 10;
    in-out property <int> m-scanrate: 1000;
    in-out property <int> m-format: 1;
    // 连接鲁棒性
    in-out property <int> m-timeout: 1000;      // 单次响应超时 ms
    in-out property <bool> m-reconnect: false;  // 通信失败后自动重连
    in-out property <int> m-reconnect-ms: 2000; // 重连间隔 ms

    // ---- Master state ----
    in-out property <[RegRow]> m-rows;
    in-out property <[string]> m-names;
    in-out property <bool> m-connected: false;
    in-out property <string> m-status: I18n.t("未连接", "Not connected");
    in-out property <int> m-tx: 0;
    in-out property <int> m-rx: 0;
    in-out property <int> m-err: 0;
    in property <string> runtime-health: "CMD 0/512 H0 R0";
    in property <bool> runtime-loss: false;
    in-out property <[LogLine]> m-log;
    in-out property <[LogLine]> m-traffic;
    in-out property <int> m-bottom-tab: 0;

    // ---- Chart ----
    in-out property <[MiniChart]> m-charts;
    in-out property <bool> m-chart-has: false;
    in-out property <[ChartSeries]> m-series;
    in-out property <string> m-axis-lmin;
    in-out property <string> m-axis-lmax;
    in-out property <string> m-axis-rmin;
    in-out property <string> m-axis-rmax;
    in-out property <bool> m-chart-has-right: false;
    in-out property <int> m-chart-page-start: 0;
    in-out property <int> m-chart-total: 0;
    in-out property <bool> m-chart-overlay: true;   // overlay vs per-register grid
    callback master-chart-axis(int, int);            // (addr, axis 0=left/1=right)
    callback master-chart-page(int);

    // ---- Poll windows (MDI) ----
    in-out property <[WinTab]> windows;
    in-out property <int> active-win: 1;

    // ---- Value-names dialog ----
    in-out property <bool> vn-open: false;
    in-out property <bool> vn-enabled: false;
    in-out property <string> vn-text: "0=Off\n1=On";

    // ---- Logging dialog ----
    in-out property <bool> log-open: false;
    in-out property <bool> log-active: false;
    in-out property <int> log-rate-mode: 0; // 0 = each read, 1 = period
    in-out property <int> log-period: 5;
    in-out property <int> log-delim: 0; // 0 = comma, 1 = tab
    in-out property <bool> log-onchange: false;
    in-out property <bool> log-timestamp: true;

    // ---- Write dialog ----
    in-out property <bool> wd-open: false;
    in-out property <int> wd-func: 1;
    in-out property <int> wd-address: 0;
    in-out property <string> wd-text: "0";
    in-out property <int> wd-type: 0;  // 0=16-bit,1=I32,2=U32,3=F32,4=I64,5=U64,6=F64
    in-out property <int> wd-order: 0; // 0=ABCD,1=CDAB,2=BADC,3=DCBA

    // ---- FC22/23 advanced client dialog ----
    in-out property <bool> adv-open: false;
    in-out property <int> mw-addr: 0;        // FC22 Mask Write 地址
    in-out property <string> mw-and: "FFFF";  // AND mask (hex)
    in-out property <string> mw-or: "0000";   // OR mask (hex)
    in-out property <int> rw-read-addr: 0;   // FC23 读地址
    in-out property <int> rw-read-qty: 4;    // FC23 读数量
    in-out property <int> rw-write-addr: 0;  // FC23 写地址
    in-out property <string> rw-write-vals: "1 2 3 4"; // 写值(空格分隔, 十进制或 0x..)
    callback master-mask-write();
    callback master-read-write();

    // ---- Per-cell format dialog (master) ----
    in-out property <bool> cf-open: false;
    in-out property <int> cf-addr: 0;
    in-out property <int> cf-fmt: 0;

    // ---- Derived channels dialog (master) ----
    in-out property <bool> dv-open: false;
    in-out property <string> dv-text: "Power = r0 * 256 + r1\nTemp = r2 * 0.1";

    // ---- Write list state (shares the read definition's function/address/quantity) ----
    in-out property <bool> wl-active: false;   // auto-write running
    in-out property <int> wl-interval: 1000;
    in-out property <[WriteRow]> wl-rows;
    callback wl-resize(int);                    // quantity changed → resize the row model
    callback wl-set-value(int, string);
    callback wl-set-auto(int, bool);

    // ---- View options dialog (display: address mode, in-cell, font) ----
    in-out property <bool> vw-open: false;

    // ---- Scan dialog ----
    in-out property <bool> scan-open: false;
    in-out property <int> sc-type: 0;
    in-out property <int> sc-func: 2;
    in-out property <int> sc-start: 0;
    in-out property <int> sc-count: 32;
    in-out property <int> sc-addr: 0;
    in-out property <int> sc-fromid: 1;
    in-out property <int> sc-toid: 32;
    in-out property <[LogLine]> scan-rows;
    in-out property <string> scan-status: I18n.t("空闲", "Idle");
    in-out property <bool> scan-running: false;

    // ---- Scaling dialog ----
    in-out property <bool> scl-open: false;
    in-out property <bool> scl-enabled: false;
    in-out property <string> scl-x1: "0";
    in-out property <string> scl-y1: "0";
    in-out property <string> scl-x2: "65535";
    in-out property <string> scl-y2: "100";
    in-out property <int> scl-decimals: 2;

    // ---- Colors dialog ----
    in-out property <bool> col-open: false;
    in-out property <int> col-normal: 0;
    in-out property <int> col-op1: 0;
    in-out property <string> col-v1: "0";
    in-out property <int> col-c1: 1;
    in-out property <int> col-op2: 0;
    in-out property <string> col-v2: "0";
    in-out property <int> col-c2: 2;

    // ---- Slave config ----
    in-out property <int> s-transport: 0;
    in-out property <string> s-host: "0.0.0.0";
    in-out property <int> s-port: 502;
    // TLS (Modbus/TCP Security) — server
    in-out property <bool> s-tls: false;
    in-out property <string> s-tls-cert;
    in-out property <string> s-tls-key;
    in-out property <bool> s-tls-require: false;   // require client cert (mutual TLS)
    in-out property <string> s-tls-cacert;         // CA to verify client certs
    in-out property <int> s-tls-cipher: 0;         // 0 auto,1 AES-128,2 AES-256,3 ChaCha20
    in-out property <int> s-tls-version: 0;        // 0 auto,1 TLS1.2,2 TLS1.3
    callback pick-s-tls-cert();
    callback pick-s-tls-key();
    callback pick-s-tls-cacert();
    in-out property <string> s-serial: "COM1";
    in-out property <int> s-baud-index: 0;
    in-out property <int> s-databits-index: 0;
    in-out property <int> s-parity: 0;
    in-out property <int> s-stopbits: 0;
    in-out property <int> s-unit-id: 1;
    in-out property <int> s-area: 2;
    // Function codes that serve the selected slave data table.
    pure function slave-fc-label(i: int) -> string {
        if i == 0 { return "FC 01/05/15 · Coils"; }
        if i == 1 { return "FC 02 · Discrete Inputs (read-only)"; }
        if i == 3 { return "FC 04 · Input Registers (read-only)"; }
        return "FC 03/06/16 · Holding Registers";
    }
    in-out property <int> s-address: 0;
    in-out property <int> s-quantity: 10;
    in-out property <int> s-format: 1;

    in-out property <bool> s-ignore-unit-id: true;

    // ---- Slave state ----
    in-out property <[RegRow]> s-rows;
    in-out property <[string]> s-names;
    in-out property <bool> s-running: false;
    in-out property <string> s-status: I18n.t("已停止", "Stopped");
    in-out property <int> s-requests: 0;
    in-out property <[LogLine]> s-log;
    in-out property <[LogLine]> s-traffic;
    in-out property <int> s-bottom-tab: 0;
    in-out property <[MiniChart]> s-charts;
    in-out property <bool> s-chart-has: false;

    // ---- Simulation dialog ----
    in-out property <bool> sim-open: false;
    in-out property <bool> sim-active: false;
    in-out property <int> sim-mode: 1; // 0 off,1 inc,2 dec,3 random,4 toggle
    in-out property <int> sim-step: 1;
    in-out property <int> sim-min: 0;
    in-out property <int> sim-max: 1000;
    in-out property <int> sim-interval: 500;
    in-out property <bool> sim-one: false;   // animate only one register
    in-out property <int> sim-target: 0;     // that register's address

    // ---- Row selection & grid options ----
    in-out property <int> m-selected-row: -1;
    in-out property <int> s-selected-row: -1;
    in-out property <int> addr-mode: 0;        // 0=Dec, 1=Hex, 2=PLC(base-1)
    in-out property <bool> addr-in-cell: false;
    in-out property <length> grid-font: 14px;

    // ---- Connection info popup ----
    in-out property <bool> conn-info-open: false;
    in-out property <string> conn-info-text: "";

    // ---- One-hour offline authorization ----
    in-out property <bool> license-open: false;
    in-out property <bool> license-unlocked: false;
    in-out property <int> license-seconds: 31536000;
    in-out property <string> license-remaining: "365d 00h";
    in property <string> license-machine-code;
    in-out property <string> license-info;
    in-out property <string> license-validity-zh;
    in-out property <string> license-validity-en;
    in-out property <string> license-error;
    callback license-import();
    callback license-copy-machine-code();

    // ---- Callbacks ----
    callback master-connect();
    callback master-disconnect();
    callback master-write();
    callback master-format-changed();
    callback master-readdef-changed();
    callback master-name(int, string);
    callback master-scaling();
    callback master-colors();
    callback master-cell-format();
    callback master-cell-format-clear();
    callback slave-cell-format();
    callback slave-cell-format-clear();
    callback master-derived();
    callback master-write-once();
    callback master-auto-write();
    callback master-auto-write-stop();
    callback master-chart-export();
    callback master-scan-address();
    callback master-scan-slave();
    callback master-scan-stop();
    callback save-workspace();
    callback open-workspace();
    callback export-csv();
    callback import-csv();
    callback new-window();
    callback select-window(int);
    callback close-window(int);
    callback float-window();
    callback master-start-log();
    callback master-stop-log();
    callback master-value-names();
    callback vn-import();
    callback vn-export();
    callback slave-start();
    callback slave-stop();
    callback slave-edit(int, string);
    callback slave-name(int, string);
    callback slave-view-changed();
    callback slave-scaling();
    callback slave-colors();
    callback slave-value-names();
    callback slave-sim-start();
    // server view-window tabs (MDI, like the client)
    in-out property <[SlaveWinTab]> s-windows;
    in-out property <int> s-active: 1;
    callback new-slave-window();
    callback select-slave-window(int);
    callback close-slave-window(int);
    callback float-slave-window();
    callback slave-sim-stop();

    // ---- Grid context actions ----
    callback master-copy(int);
    callback master-delete(int);
    callback master-chart(int);
    callback slave-copy(int);
    callback slave-delete(int);
    callback slave-chart(int);
    callback slave-autoinc(int);
    callback open-master-chart();  // 打开主站独立 Chart 子窗
    callback open-slave-chart();   // 打开从站独立 Chart 子窗

    // ---- Keyboard shortcuts ----
    callback key-new-window();
    callback key-save();
    callback key-reconnect();
    callback key-delete-selected();

    // ---- Connection info ----
    callback show-conn-info();

    key-fs := FocusScope {
        width: 100%;
        height: 100%;
        // Grab focus on startup so the Ctrl shortcuts work before any field is clicked.
        init => {
            Theme.dark = root.dark;
            I18n.en = root.lang-en;
            Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
            self.focus();
        }
        key-pressed(event) => {
            if event.modifiers.control && event.text == "s" {
                root.key-save();
                accept;
            } else if event.modifiers.control && event.text == "n" {
                root.key-new-window();
                accept;
            } else if event.modifiers.control && event.text == "r" {
                root.key-reconnect();
                accept;
            } else if event.modifiers.control && event.text == "d" {
                root.key-delete-selected();
                accept;
            } else {
                reject;
            }
        }
        VerticalLayout {
        width: 100%;
        height: 100%;

        Rectangle {
            height: ProductDesign.product-header-height;
            background: Theme.header;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                Rectangle {
                    min-width: 26px;
                    preferred-width: 26px;
                    max-width: 26px;
                    horizontal-stretch: 0;
                    Image {
                        source: @image-url("logo.svg");
                        width: 26px;
                        height: 26px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: "Modbus Tools";
                    color: Theme.accent-fg;
                    font-size: ProductDesign.product-title-font-size;
                    font-weight: 800;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle { horizontal-stretch: 1; }
                ProductHeaderButton { text: I18n.t("连接参数", "Connection"); clicked => { root.connection-open = !root.connection-open; } }
                if !root.narrow: license-chip := Rectangle {
                    min-width: 104px;
                    preferred-width: 104px;
                    max-width: 104px;
                    height: ProductDesign.toolbar-control-height;
                    horizontal-stretch: 0;
                    border-radius: ProductDesign.radius-sm;
                    background: license-chip-area.pressed ? ProductDesign.on-brand-border
                        : root.license-unlocked ? Theme.ok.with-alpha(0.24)
                        : root.license-seconds <= 600 ? Theme.warn.with-alpha(0.26)
                        : ProductDesign.on-brand-faint;
                    border-width: license-chip-focus.has-focus ? ProductDesign.focus-width : 1px;
                    border-color: license-chip-focus.has-focus ? Theme.warn
                        : root.license-unlocked ? Theme.ok
                        : root.license-seconds <= 600 ? Theme.warn
                        : ProductDesign.on-brand-border;
                    accessible-role: AccessibleRole.button;
                    accessible-label: root.license-unlocked
                        ? I18n.t("已授权", "Licensed")
                        : I18n.t("剩余试用时间 ", "Trial remaining ") + root.license-remaining;
                    forward-focus: license-chip-focus;
                    accessible-action-default => { root.license-open = true; }
                    animate background { duration: 80ms; }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.license-unlocked
                            ? I18n.t("已授权", "Licensed")
                            : I18n.t("试用 ", "Trial ") + root.license-remaining;
                        color: Theme.accent-fg;
                        font-size: ProductDesign.font-sm;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    license-chip-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.license-error = "";
                            root.license-open = true;
                        }
                    }
                    license-chip-focus := FocusScope {
                        x: 0px;
                        width: 0px;
                        key-pressed(event) => {
                            if event.text == Key.Return || event.text == " " {
                                root.license-error = "";
                                root.license-open = true;
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
                Rectangle {
                    min-width: 62px; preferred-width: 62px; max-width: 62px;
                    ProductHeaderCheck { fixed-width: 62px; text: I18n.t("置顶", "Pin"); checked <=> root.topmost-enabled; }
                }
                Rectangle {
                    min-width: 62px; preferred-width: 62px; max-width: 62px;
                    ProductLanguageSwitch { fixed-width: 62px; en <=> root.lang-en; }
                }
                ProductDensitySwitch { }
                Rectangle {
                    min-width: 88px; preferred-width: 88px; max-width: 88px;
                    ProductThemeSwitch { fixed-width: 88px; dark <=> root.dark; }
                }
                Rectangle {
                    min-width: 160px; preferred-width: 160px; max-width: 160px;
                    ModeSwitch {
                        fixed-width: 160px;
                        height: ProductDesign.toolbar-control-height;
                        left-text: I18n.t("主站", "Client");
                        right-text: I18n.t("从站", "Server");
                        selected <=> root.active-mode;
                    }
                }
            }
        }

        // ===== Master page =====
        if root.active-mode == 0: HorizontalLayout {
            padding: root.page-gap;
            spacing: root.page-gap;

            Rectangle {
                width: root.connection-open ? root.connection-width : 0px;
                visible: root.connection-open; clip: true;
                border-radius: 10px;
                background: ProductDesign.surface;
                border-width: 1px;
                border-color: ProductDesign.border;
                mscroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    VerticalLayout {
                        width: mscroll.visible-width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 6px;

                        Text { text: I18n.t("连接", "Connection"); font-weight: 800; font-size: 15px; }
                        Field { label: I18n.t("模式：", "Mode:"); ComboBox { model: ["Modbus RTU", "Modbus TCP", "Modbus UDP", "Modbus RTU over TCP", "Modbus RTU over UDP"]; current-index <=> root.m-transport; } }
                        if root.m-transport != 0: Field { label: I18n.t("主机：", "Host:"); LineEdit { text <=> root.m-host; } }
                        if root.m-transport != 0: Field { label: I18n.t("端口：", "Port:"); SpinBox { value <=> root.m-port; minimum: 1; maximum: 65535; } }
                        if root.m-transport == 1: Field { label: "TLS:"; HorizontalLayout { spacing: 8px; CheckBox { text: "Modbus/TCP TLS"; checked <=> root.m-tls; } Rectangle { horizontal-stretch: 1; } } }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("CA 文件：", "CA file:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.m-tls-ca; placeholder-text: I18n.t("服务器/CA PEM（空白=系统信任库）", "server/CA PEM (blank = system roots)"); } ProductButton { text: "…"; width: 30px; clicked => { root.pick-m-tls-ca(); } } } }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("域名：", "Domain:"); LineEdit { text <=> root.m-tls-domain; placeholder-text: I18n.t("SNI（空白=主机）", "SNI (blank = host)"); } }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("版本：", "Version:"); ComboBox { model: [I18n.t("自动（1.2 + 1.3）", "Auto (1.2 + 1.3)"), I18n.t("仅 TLS 1.2", "TLS 1.2 only"), I18n.t("仅 TLS 1.3", "TLS 1.3 only")]; current-index <=> root.m-tls-version; } }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("密码套件：", "Cipher:"); ComboBox { model: [I18n.t("自动（最强）", "Auto (strongest)"), "AES-128-GCM", "AES-256-GCM", "ChaCha20-256"]; current-index <=> root.m-tls-cipher; } }
                        if root.m-transport == 1 && root.m-tls: Field {
                            label: "";
                            CheckBox {
                                text: I18n.t("不安全：跳过证书验证", "Insecure: skip certificate verification");
                                checked <=> root.m-tls-skip;
                                accessible-description: I18n.t(
                                    "仅用于隔离测试环境；服务器身份不会被验证",
                                    "For isolated test environments only; server identity will not be verified"
                                );
                            }
                        }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("客户端证书：", "Client cert:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.m-tls-cert; placeholder-text: I18n.t("PEM（空白=不启用双向 TLS）", "PEM (blank = no mutual TLS)"); } ProductButton { text: "…"; width: 30px; clicked => { root.pick-m-tls-cert(); } } } }
                        if root.m-transport == 1 && root.m-tls: Field { label: I18n.t("客户端私钥：", "Client key:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.m-tls-key; placeholder-text: "PEM"; } ProductButton { text: "…"; width: 30px; clicked => { root.pick-m-tls-key(); } } } }
                        if root.m-transport == 0: Field { label: I18n.t("串口：", "Serial:"); LineEdit { text <=> root.m-serial; placeholder-text: "COM1"; } }
                        if root.m-transport == 0: Field { label: I18n.t("波特率：", "Baud:"); ComboBox { model: ["9600", "19200", "38400", "57600", "115200"]; current-index <=> root.m-baud-index; } }
                        if root.m-transport == 0: Field { label: I18n.t("数据位：", "Data bits:"); ComboBox { model: ["8", "7", "6", "5"]; current-index <=> root.m-databits-index; } }
                        if root.m-transport == 0: Field { label: I18n.t("校验：", "Parity:"); ComboBox { model: ["None", "Even", "Odd"]; current-index <=> root.m-parity; } }
                        if root.m-transport == 0: Field { label: I18n.t("停止位：", "Stop bits:"); ComboBox { model: ["1", "2"]; current-index <=> root.m-stopbits; } }

                        Rectangle { height: 8px; }
                        Text { text: I18n.t("读写定义", "Read definition"); font-weight: 800; font-size: 15px; }
                        Field { label: I18n.t("从站 ID：", "Slave ID:"); SpinBox { value <=> root.m-slave-id; minimum: 0; maximum: 247; } }
                        Field { label: I18n.t("功能码：", "Function:"); ComboBox {
                            model: [I18n.t("01 读线圈", "01 Read Coils"), I18n.t("02 读离散输入", "02 Read Discrete Inputs"), I18n.t("03 读保持寄存器", "03 Read Holding Registers"), I18n.t("04 读输入寄存器", "04 Read Input Registers"), I18n.t("05 写单个线圈", "05 Write Single Coil"), I18n.t("06 写单个寄存器", "06 Write Single Register"), I18n.t("15 写多个线圈", "15 Write Multiple Coils"), I18n.t("16 写多个寄存器", "16 Write Multiple Registers")];
                            current-index <=> root.m-function;
                            selected => {
                                root.m-quantity = min(root.m-quantity, min(root.quantity-limit(root.m-function), 65536 - root.m-address));
                                if root.m-function == 4 || root.m-function == 5 {
                                    root.m-quantity = 1;
                                }
                                root.wl-resize(root.m-quantity);
                                root.master-readdef-changed();
                            }
                        } }
                        Field { label: I18n.t("地址：", "Address:"); SpinBox {
                            value <=> root.m-address;
                            minimum: 0;
                            maximum: 65535;
                            edited => {
                                root.m-quantity = min(root.m-quantity, min(root.quantity-limit(root.m-function), 65536 - self.value));
                                root.wl-resize(root.m-quantity);
                                root.master-readdef-changed();
                            }
                        } }
                        Field { label: I18n.t("数量：", "Quantity:"); SpinBox {
                            value <=> root.m-quantity;
                            minimum: 1;
                            maximum: min(root.quantity-limit(root.m-function), 65536 - root.m-address);
                            enabled: root.m-function != 4 && root.m-function != 5;
                            edited => { root.wl-resize(self.value); root.master-readdef-changed(); }
                        } }
                        Field { label: I18n.t("扫描周期 ms：", "Scan ms:"); SpinBox { value <=> root.m-scanrate; minimum: 20; maximum: 60000; step-size: 100; edited => { root.master-readdef-changed(); } } }
                        Field { label: I18n.t("格式：", "Format:"); ComboBox { model: Fmt.list; current-index <=> root.m-format; selected => { root.master-format-changed(); } } }
                        // 连接鲁棒性(下次连接时生效)
                        Field { label: I18n.t("超时 ms：", "Timeout ms:"); SpinBox { value <=> root.m-timeout; minimum: 20; maximum: 60000; step-size: 100; } }
                        Field { label: I18n.t("自动重连：", "Reconnect:"); CheckBox { checked <=> root.m-reconnect; text: root.m-reconnect ? I18n.t("开启", "auto") : I18n.t("关闭", "off"); } }
                        Field { label: I18n.t("重连间隔 ms：", "Reconn ms:"); SpinBox { value <=> root.m-reconnect-ms; minimum: 200; maximum: 60000; step-size: 500; } }

                        Rectangle { height: 10px; }
                        AccentButton {
                            text: root.m-connected ? I18n.t("断开", "Disconnect") : (root.m-function < 4 ? I18n.t("连接并轮询", "Connect & Poll") : I18n.t("连接（写入）", "Connect (write)"));
                            height: 36px;
                            clicked => { root.m-connected ? root.master-disconnect() : root.master-connect(); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ProductButton { text: I18n.t("写入…", "Write…"); horizontal-stretch: 1; clicked => { root.wd-func = root.m-function == 0 ? 0 : 1; root.wd-open = true; } }
                            ProductButton { text: I18n.t("扫描…", "Scan…"); horizontal-stretch: 1; clicked => { root.scan-open = true; } }
                        }
                        Rectangle { vertical-stretch: 1; min-height: 8px; }

                        // ---- live poll statistics ----
                        Rectangle {
                            height: stats-vl.preferred-height;
                            border-radius: 8px;
                            background: ProductDesign.zebra;
                            border-width: 1px;
                            border-color: ProductDesign.border;
                            stats-vl := VerticalLayout {
                                padding: 10px;
                                spacing: 5px;
                                Text { text: I18n.t("统计", "Statistics"); font-weight: 800; font-size: ProductDesign.body-font-size; }
                                HorizontalLayout { Text { text: I18n.t("轮询", "Polls"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.m-tx}"; font-weight: 600; } }
                                HorizontalLayout { Text { text: I18n.t("响应", "Responses"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.m-rx}"; font-weight: 600; } }
                                HorizontalLayout { Text { text: I18n.t("错误", "Errors"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.m-err}"; font-weight: 600; color: root.m-err > 0 ? Theme.err : ProductDesign.text; } }
                                HorizontalLayout { Text { text: I18n.t("成功率", "Success"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: root.m-tx > 0 ? "\{Math.round(root.m-rx / root.m-tx * 100)}%" : "—"; font-weight: 600; color: Theme.ok; } }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 4;
                spacing: 10px;

                // ----- poll window tabs (MDI) -----
                HorizontalLayout {
                    spacing: 6px;
                    height: 36px;
                    ScrollView { horizontal-stretch: 1; HorizontalLayout { spacing: 6px;
                    for w in root.windows: Rectangle {
                        width: wtxt.preferred-width + 50px;
                        border-radius: 6px;
                        background: w.id == root.active-win ? Theme.accent : ProductDesign.surface;
                        border-width: 1px;
                        border-color: ProductDesign.border;
                        TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { root.active-win = w.id; root.select-window(w.id); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px; border-radius: 4px;
                                y: (parent.height - self.height) / 2;
                                background: w.connected ? Theme.ok : Theme.text-muted;
                            }
                            wtxt := Text {
                                text: w.title;
                                vertical-alignment: center;
                                color: w.id == root.active-win ? Theme.accent-fg : ProductDesign.text;
                            }
                            Rectangle {
                                width: 18px;
                                y: (parent.height - self.height) / 2;
                                height: 18px;
                                close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.close-window(w.id); } }
                                Image { source: @image-url("../../ui/icons/close.svg"); width: 16px; height: 16px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; colorize: ProductDesign.text-muted; }
                            }
                        }
                    }
                    } } // close tab HorizontalLayout + ScrollView
                    ProductButton { text: I18n.t("+ 新建", "+ New"); clicked => { root.new-window(); } }
                    ProductButton { text: I18n.t("浮动", "Float"); clicked => { root.float-window(); } }
                }

                // 工具栏：横向 ScrollView 包裹，窄窗口下可横向滚动到全部按钮(不再挤出/裁剪)
                ToolBar {
                    ScrollView {
                        width: 100%; height: 100%;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            ToolAction { text: I18n.t("保存工作区", "Save Workspace"); action-width: 132px; clicked => { root.save-workspace(); } }
                            ToolAction { text: I18n.t("打开工作区", "Open Workspace"); action-width: 132px; clicked => { root.open-workspace(); } }
                            ToolAction { text: I18n.t("导入", "Import"); action-width: 88px; clicked => { root.import-csv(); } }
                            ToolAction { text: I18n.t("导出", "Export"); action-width: 88px; clicked => { root.export-csv(); } }
                            ToolAction { text: I18n.t("视图…", "View…"); action-width: 92px; clicked => { root.vw-open = true; } }
                            Rectangle { width: 8px; }
                            ToolAction { text: I18n.t("记录…", "Log…"); action-width: 92px; clicked => { root.log-open = true; } }
                            ToolAction { text: "FC22/23…"; action-width: 116px; enabled: root.m-connected; clicked => { root.adv-open = true; } }
                        }
                    }
                }

                // ---- function-code indicator for the display area ----
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: root.m-function >= 4 ? Theme.warn.with-alpha(0.16) : Theme.accent.with-alpha(0.14);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Rectangle {
                            width: 50px;
                            border-radius: 4px;
                            background: root.m-function >= 4 ? Theme.warn : Theme.accent;
                            y: (parent.height - self.height) / 2;
                            height: 20px;
                            Text {
                                text: root.m-function >= 4 ? I18n.t("写入", "WRITE") : I18n.t("读取", "READ");
                                color: Theme.accent-fg; font-size: ProductDesign.font-xs; font-weight: 800;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text { text: root.fc-label(root.m-function); vertical-alignment: center; font-weight: 700; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "@ \{root.m-address} × \{root.m-quantity}";
                            vertical-alignment: center; opacity: 0.6;
                        }
                    }
                }

                // READ functions (FC01-04): live poll grid.
                if root.m-function < 4: DataGrid {
                    vertical-stretch: 1;
                    rows: root.m-rows;
                    names: root.m-names;
                    values-editable: false;
                    addr-mode <=> root.addr-mode;
                    addr-in-cell: root.addr-in-cell;
                    grid-font: root.grid-font;
                    selected-row <=> root.m-selected-row;
                    name-edit(addr, txt) => { root.master-name(addr, txt); }
                    activate(addr) => { root.wd-address = addr; root.wd-func = root.m-function == 0 ? 0 : 1; root.wd-open = true; }
                    row-copy(addr) => { root.master-copy(addr); }
                    row-delete(addr) => { root.master-delete(addr); }
                    row-chart(addr) => { root.master-chart(addr); root.open-master-chart(); }
                    row-format(addr) => { root.cf-addr = addr; root.cf-fmt = root.m-format; root.cf-open = true; }
                }
                // WRITE functions (FC05/06/15/16): editable write grid over the same
                // Address/Quantity definition. Address column = Address + index.
                if root.m-function >= 4: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: ProductDesign.surface;
                    border-width: 1px;
                    border-color: ProductDesign.border;
                    clip: true;
                    VerticalLayout {
                        Rectangle {
                            height: ProductDesign.form-control-height;
                            background: ProductDesign.zebra;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { width: 110px; text: I18n.t("地址", "Address"); vertical-alignment: center; font-weight: 700; }
                                Text { horizontal-stretch: 1; text: I18n.t("写入值", "Value to write"); vertical-alignment: center; font-weight: 700; }
                                Text { width: 80px; text: I18n.t("自增", "Auto-inc"); vertical-alignment: center; font-weight: 700; }
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for row[i] in root.wl-rows: Rectangle {
                                height: 30px;
                                background: Math.mod(i, 2) == 0 ? transparent : ProductDesign.zebra;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { width: 110px; text: root.m-address + i; vertical-alignment: center; font-weight: 600; }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: row.value;
                                        placeholder-text: "0";
                                        edited(t) => { root.wl-set-value(i, t); }
                                    }
                                    Rectangle {
                                        width: 80px;
                                        CheckBox {
                                            checked: row.auto;
                                            toggled => { root.wl-set-auto(i, self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 40px;
                            padding: 6px;
                            spacing: 10px;
                            ProductButton { text: I18n.t("写入一次", "Write Once"); enabled: root.m-connected; clicked => { root.master-write-once(); } }
                            ProductButton {
                                text: root.wl-active ? "Stop Auto" : "Start Auto";
                                enabled: root.m-connected;
                                clicked => {
                                    if (root.wl-active) { root.master-auto-write-stop(); root.wl-active = false; }
                                    else { root.master-auto-write(); } // wl-active 由后端校验通过后在 Rust 里置
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: I18n.t("自动周期 ms", "Auto ms"); vertical-alignment: center; }
                            SpinBox { value <=> root.wl-interval; minimum: 50; maximum: 60000; step-size: 100; width: 100px; }
                            Text {
                                text: root.wl-active ? "running" : "stopped";
                                vertical-alignment: center;
                                color: root.wl-active ? Theme.ok : ProductDesign.text;
                                font-weight: 700;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Tab { label: I18n.t("事件日志", "Event Log"); active: root.m-bottom-tab == 0; clicked => { root.m-bottom-tab = 0; } }
                    Tab { label: I18n.t("通信流量", "Communication Traffic"); active: root.m-bottom-tab == 1; clicked => { root.m-bottom-tab = 1; } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("曲线窗口 ↗", "Chart Window ↗"); clicked => { root.open-master-chart(); } }
                }
                if root.m-bottom-tab == 0: LogPanel { height: 190px; lines: root.m-log; }
                if root.m-bottom-tab == 1: LogPanel { height: 190px; lines: root.m-traffic; }

                // ---- bottom status bar (connection state + Tx/Rx/Err) ----
                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: ProductDesign.zebra;
                    border-width: 1px;
                    border-color: ProductDesign.border;
                    TouchArea { width: 100%; height: 100%; clicked => { root.show-conn-info(); root.conn-info-open = true; } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 18px;
                        ProductStatusDot {
                            y: (parent.height - self.height) / 2;
                            active: root.m-connected;
                            warning: root.m-err > 0 || root.runtime-loss;
                        }
                        Text { horizontal-stretch: 1; text: root.m-status; vertical-alignment: center; overflow: elide; font-size: ProductDesign.font-sm; }
                        Text { text: root.runtime-health; color: root.runtime-loss ? Theme.err : ProductDesign.text; vertical-alignment: center; font-size: ProductDesign.font-xs; }
                        Text { text: "Tx: \{root.m-tx}"; vertical-alignment: center; font-size: ProductDesign.font-sm; }
                        Text { text: "Rx: \{root.m-rx}"; vertical-alignment: center; font-size: ProductDesign.font-sm; }
                        Text { text: "Err: \{root.m-err}"; vertical-alignment: center; font-size: ProductDesign.font-sm; color: root.m-err > 0 ? Theme.err : ProductDesign.text; }
                    }
                }
            }
        }

        // ===== Slave page =====
        if root.active-mode == 1: HorizontalLayout {
            padding: root.page-gap;
            spacing: root.page-gap;

            Rectangle {
                width: root.connection-open ? root.connection-width : 0px;
                visible: root.connection-open; clip: true;
                border-radius: 10px;
                background: ProductDesign.surface;
                border-width: 1px;
                border-color: ProductDesign.border;
                sscroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    VerticalLayout {
                        width: sscroll.visible-width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 6px;

                        Text { text: I18n.t("从站连接", "Server connection"); font-weight: 800; font-size: 15px; }
                        Field { label: I18n.t("模式：", "Mode:"); ComboBox { model: ["Modbus RTU", "Modbus TCP", "Modbus UDP", "Modbus RTU over TCP", "Modbus RTU over UDP"]; current-index <=> root.s-transport; } }
                        if root.s-transport != 0: Field {
                            label: I18n.t("本机监听地址：", "Local listen:");
                            LineEdit {
                                text <=> root.s-host;
                                placeholder-text: I18n.t("0.0.0.0（监听全部本机网卡）", "0.0.0.0 (all local interfaces)");
                            }
                        }
                        if root.s-transport != 0: Field { label: I18n.t("端口：", "Port:"); SpinBox { value <=> root.s-port; minimum: 1; maximum: 65535; } }
                        if root.s-transport == 1: Field { label: "TLS:"; HorizontalLayout { spacing: 8px; CheckBox { text: "Modbus/TCP TLS"; checked <=> root.s-tls; } Rectangle { horizontal-stretch: 1; } } }
                        if root.s-transport == 1 && root.s-tls: Field { label: I18n.t("证书文件：", "Cert file:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.s-tls-cert; placeholder-text: I18n.t("服务器证书 PEM", "server cert PEM"); } ProductButton { text: "…"; width: 30px; clicked => { root.pick-s-tls-cert(); } } } }
                        if root.s-transport == 1 && root.s-tls: Field { label: I18n.t("私钥文件：", "Key file:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.s-tls-key; placeholder-text: I18n.t("私钥 PEM", "private key PEM"); } ProductButton { text: "…"; width: 30px; clicked => { root.pick-s-tls-key(); } } } }
                        if root.s-transport == 1 && root.s-tls: Field { label: I18n.t("版本：", "Version:"); ComboBox { model: [I18n.t("自动（1.2 + 1.3）", "Auto (1.2 + 1.3)"), I18n.t("仅 TLS 1.2", "TLS 1.2 only"), I18n.t("仅 TLS 1.3", "TLS 1.3 only")]; current-index <=> root.s-tls-version; } }
                        if root.s-transport == 1 && root.s-tls: Field { label: I18n.t("密码套件：", "Cipher:"); ComboBox { model: [I18n.t("自动（最强）", "Auto (strongest)"), "AES-128-GCM", "AES-256-GCM", "ChaCha20-256"]; current-index <=> root.s-tls-cipher; } }
                        if root.s-transport == 1 && root.s-tls: Field { label: ""; CheckBox { text: I18n.t("要求客户端证书", "Require client cert"); checked <=> root.s-tls-require; } }
                        if root.s-transport == 1 && root.s-tls && root.s-tls-require: Field { label: I18n.t("客户端 CA：", "Client CA:"); HorizontalLayout { spacing: 4px; LineEdit { text <=> root.s-tls-cacert; placeholder-text: I18n.t("用于验证客户端的 CA PEM", "CA PEM to verify clients"); } ProductButton { text: "…"; width: 30px; clicked => { root.pick-s-tls-cacert(); } } } }
                        if root.s-transport == 0: Field { label: I18n.t("串口：", "Serial:"); LineEdit { text <=> root.s-serial; placeholder-text: "COM1"; } }
                        if root.s-transport == 0: Field { label: I18n.t("波特率：", "Baud:"); ComboBox { model: ["9600", "19200", "38400", "57600", "115200"]; current-index <=> root.s-baud-index; } }
                        if root.s-transport == 0: Field { label: I18n.t("数据位：", "Data bits:"); ComboBox { model: ["8", "7", "6", "5"]; current-index <=> root.s-databits-index; } }
                        if root.s-transport == 0: Field { label: I18n.t("校验：", "Parity:"); ComboBox { model: ["None", "Even", "Odd"]; current-index <=> root.s-parity; } }
                        if root.s-transport == 0: Field { label: I18n.t("停止位：", "Stop bits:"); ComboBox { model: ["1", "2"]; current-index <=> root.s-stopbits; } }
                        Field { label: I18n.t("单元 ID：", "Unit ID:"); SpinBox { value <=> root.s-unit-id; minimum: 0; maximum: 247; } }
                        if root.s-transport == 1 || root.s-transport == 2: Field { label: ""; CheckBox { text: I18n.t("忽略单元 ID", "Ignore Unit ID"); checked <=> root.s-ignore-unit-id; } }

                        Rectangle { height: 8px; }
                        Text { text: I18n.t("内存视图", "Memory view"); font-weight: 800; font-size: 15px; }
                        Field { label: I18n.t("数据表：", "Table:"); ComboBox { model: ["01/05/15 Coils", "02 Discrete Inputs", "03/06/16 Holding Registers", "04 Input Registers"]; current-index <=> root.s-area; selected => { root.slave-view-changed(); } } }
                        Field { label: I18n.t("地址：", "Address:"); SpinBox { value <=> root.s-address; minimum: 0; maximum: 65535; edited => { root.slave-view-changed(); } } }
                        Field { label: I18n.t("数量：", "Quantity:"); SpinBox { value <=> root.s-quantity; minimum: 1; maximum: 2000; edited => { root.slave-view-changed(); } } }
                        Field { label: I18n.t("格式：", "Format:"); ComboBox { model: Fmt.list; current-index <=> root.s-format; selected => { root.slave-view-changed(); } } }

                        Rectangle { height: 10px; }
                        AccentButton {
                            text: root.s-running ? I18n.t("停止从站", "Stop server") : I18n.t("启动从站", "Start server");
                            height: 36px;
                            clicked => { root.s-running ? root.slave-stop() : root.slave-start(); }
                        }
                        Text {
                            text: I18n.t(
                                "编辑数值单元格并按 Enter 写入寄存器；主站可实时轮询和写入。",
                                "Edit a Value cell and press Enter to set a register. Masters can poll and write live."
                            );
                            wrap: word-wrap;
                            font-size: ProductDesign.font-sm;
                            opacity: 0.65;
                        }
                        Rectangle { vertical-stretch: 1; min-height: 8px; }

                        // ---- live server statistics ----
                        Rectangle {
                            height: sstats-vl.preferred-height;
                            border-radius: 8px;
                            background: ProductDesign.zebra;
                            border-width: 1px;
                            border-color: ProductDesign.border;
                            sstats-vl := VerticalLayout {
                                padding: 10px;
                                spacing: 5px;
                                Text { text: I18n.t("统计", "Statistics"); font-weight: 800; font-size: ProductDesign.body-font-size; }
                                HorizontalLayout { Text { text: I18n.t("请求", "Requests"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.s-requests}"; font-weight: 600; } }
                                HorizontalLayout { Text { text: I18n.t("运行", "Running"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: root.s-running ? I18n.t("是", "Yes") : I18n.t("否", "No"); font-weight: 600; color: root.s-running ? Theme.ok : ProductDesign.text; } }
                                HorizontalLayout { Text { text: I18n.t("仿真", "Simulating"); opacity: 0.7; } Rectangle { horizontal-stretch: 1; } Text { text: root.sim-active ? I18n.t("是", "Yes") : I18n.t("否", "No"); font-weight: 600; color: root.sim-active ? Theme.warn : ProductDesign.text; } }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 4;
                spacing: 10px;

                // ----- server view-window tabs (MDI, like the client) -----
                HorizontalLayout {
                    spacing: 6px;
                    height: 36px;
                    ScrollView { horizontal-stretch: 1; HorizontalLayout { spacing: 6px;
                    for w in root.s-windows: Rectangle {
                        width: swtxt.preferred-width + 50px;
                        border-radius: 6px;
                        background: w.id == root.s-active ? Theme.accent : ProductDesign.surface;
                        border-width: 1px;
                        border-color: ProductDesign.border;
                        TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { root.s-active = w.id; root.select-slave-window(w.id); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 6px;
                            swtxt := Text {
                                text: w.title;
                                vertical-alignment: center;
                                color: w.id == root.s-active ? Theme.accent-fg : ProductDesign.text;
                            }
                            Rectangle {
                                width: 18px; height: 18px;
                                y: (parent.height - self.height) / 2;
                                sclose-ta := TouchArea { mouse-cursor: pointer; clicked => { root.close-slave-window(w.id); } }
                                Image { source: @image-url("../../ui/icons/close.svg"); width: 16px; height: 16px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; colorize: ProductDesign.text-muted; }
                            }
                        }
                    }
                    } } // close tab HorizontalLayout + ScrollView
                    ProductButton { text: I18n.t("+ 新建", "+ New"); clicked => { root.new-slave-window(); } }
                    ProductButton { text: I18n.t("浮动", "Float"); clicked => { root.float-slave-window(); } }
                }

                ToolBar {
                    ScrollView {
                        width: 100%; height: 100%;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            ToolAction { text: I18n.t("保存工作区", "Save Workspace"); action-width: 132px; clicked => { root.save-workspace(); } }
                            ToolAction { text: I18n.t("打开工作区", "Open Workspace"); action-width: 132px; clicked => { root.open-workspace(); } }
                            ToolAction { text: I18n.t("导入", "Import"); action-width: 88px; clicked => { root.import-csv(); } }
                            ToolAction { text: I18n.t("导出", "Export"); action-width: 88px; clicked => { root.export-csv(); } }
                            ToolAction { text: I18n.t("视图…", "View…"); action-width: 92px; clicked => { root.vw-open = true; } }
                            Rectangle { width: 8px; }
                            ToolAction { text: I18n.t("仿真…", "Simulate…"); action-width: 110px; clicked => { root.sim-open = true; } }
                            ToolAction { text: I18n.t("连接信息…", "Connection…"); action-width: 116px; clicked => { root.show-conn-info(); root.conn-info-open = true; } }
                        }
                    }
                }

                // ---- function-code indicator (server serves these FCs for the table) ----
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: Theme.ok.with-alpha(0.14);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Rectangle {
                            width: 58px;
                            height: 20px;
                            border-radius: 4px;
                            background: Theme.ok;
                            y: (parent.height - self.height) / 2;
                            Text { text: I18n.t("服务端", "SERVER"); color: Theme.accent-fg; font-size: ProductDesign.font-xs; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: root.slave-fc-label(root.s-area); vertical-alignment: center; font-weight: 700; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "@ \{root.s-address} × \{root.s-quantity}"; vertical-alignment: center; opacity: 0.6; }
                    }
                }

                DataGrid {
                    vertical-stretch: 1;
                    rows: root.s-rows;
                    names: root.s-names;
                    values-editable: true;
                    addr-mode <=> root.addr-mode;
                    addr-in-cell: root.addr-in-cell;
                    grid-font: root.grid-font;
                    selected-row <=> root.s-selected-row;
                    edit(addr, txt) => { root.slave-edit(addr, txt); }
                    name-edit(addr, txt) => { root.slave-name(addr, txt); }
                    row-copy(addr) => { root.slave-copy(addr); }
                    row-delete(addr) => { root.slave-delete(addr); }
                    row-chart(addr) => { root.slave-chart(addr); root.open-slave-chart(); }
                    row-format(addr) => { root.cf-addr = addr; root.cf-fmt = root.s-format; root.cf-open = true; }
                    allow-autoinc: true;
                    row-autoinc(addr) => { root.slave-autoinc(addr); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Tab { label: I18n.t("事件日志", "Event Log"); active: root.s-bottom-tab == 0; clicked => { root.s-bottom-tab = 0; } }
                    Tab { label: I18n.t("通信流量", "Communication Traffic"); active: root.s-bottom-tab == 1; clicked => { root.s-bottom-tab = 1; } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("曲线窗口 ↗", "Chart Window ↗"); clicked => { root.open-slave-chart(); } }
                }
                if root.s-bottom-tab == 0: LogPanel { height: 190px; lines: root.s-log; }
                if root.s-bottom-tab == 1: LogPanel { height: 190px; lines: root.s-traffic; }

                // ---- bottom status bar ----
                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: ProductDesign.zebra;
                    border-width: 1px;
                    border-color: ProductDesign.border;
                    TouchArea { width: 100%; height: 100%; clicked => { root.show-conn-info(); root.conn-info-open = true; } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 18px;
                        ProductStatusDot {
                            y: (parent.height - self.height) / 2;
                            active: root.s-running;
                            warning: root.runtime-loss;
                        }
                        Text { horizontal-stretch: 1; text: root.s-status; vertical-alignment: center; overflow: elide; font-size: ProductDesign.font-sm; }
                        Text { text: root.runtime-health; color: root.runtime-loss ? Theme.err : ProductDesign.text; vertical-alignment: center; font-size: ProductDesign.font-xs; }
                        Text { text: root.sim-active ? "Simulating" : ""; vertical-alignment: center; color: Theme.warn; font-size: ProductDesign.font-sm; }
                        Text { text: "Requests: \{root.s-requests}"; vertical-alignment: center; font-size: ProductDesign.font-sm; }
                    }
                }
            }
        }
        }
    }

    // =====================================================================
    // Write dialog
    // =====================================================================
    ProductModal {
        open: root.wd-open;
        close-requested => { root.wd-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 460px;
            dialog-height: 440px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("写入从站", "Write to slave"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("类型：", "Type:"); ComboBox {
                    model: ["16-bit", "32-bit Int", "32-bit UInt", "32-bit Float", "64-bit Int", "64-bit UInt", "64-bit Double"];
                    current-index <=> root.wd-type;
                } }
                if root.wd-type == 0: Field { label: I18n.t("功能码：", "Function:"); ComboBox {
                    model: [I18n.t("05 写单个线圈", "05 Write Single Coil"), I18n.t("06 写单个寄存器", "06 Write Single Register"), I18n.t("15 写多个线圈", "15 Write Multiple Coils"), I18n.t("16 写多个寄存器", "16 Write Multiple Registers")];
                    current-index <=> root.wd-func;
                } }
                if root.wd-type > 0: Field { label: I18n.t("字节序：", "Byte order:"); ComboBox {
                    model: ["ABCD", "CDAB", "BADC", "DCBA"];
                    current-index <=> root.wd-order;
                } }
                Field { label: I18n.t("从站 ID：", "Slave ID:"); Text { text: "\{root.m-slave-id}"; vertical-alignment: center; } }
                Field { label: I18n.t("地址：", "Address:"); SpinBox { value <=> root.wd-address; minimum: 0; maximum: 65535; } }
                Field { label: I18n.t("数值：", "Value(s):"); LineEdit { text <=> root.wd-text; placeholder-text: "123 / 0x1F / 3.14 / on"; } }
                Text {
                    text: root.wd-type > 0
                        ? I18n.t("输入一个数值，例如 3.14159；按字节序编码到多个寄存器，通过 FC16 写入。", "Enter one number; it is encoded across registers (FC16) using the byte order. e.g. 3.14159")
                        : (root.wd-func >= 2 ? I18n.t("批量写入：以逗号分隔数值，例如 10,20,30 或 1,0,1。", "Multiple write: separate values with commas (e.g. 10,20,30 or 1,0,1).") : I18n.t("单次写入一个数值；线圈支持 0/1/on/off。", "Single write: one value. Coils accept 0/1/on/off."));
                    wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.wd-open = false; } }
                    AccentButton { text: I18n.t("发送", "Send"); width: 90px; clicked => { root.master-write(); root.wd-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // FC22 / FC23 advanced client dialog (server already supports them)
    // =====================================================================
    ProductModal {
        open: root.adv-open;
        close-requested => { root.adv-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 480px;
            dialog-height: 430px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: I18n.t("高级写入 — FC22 / FC23", "Advanced write — FC22 / FC23"); font-size: 17px; font-weight: 800; }
                Text { text: "结果显示在下方 Event Log。Slave ID: \{root.m-slave-id}"; font-size: ProductDesign.font-sm; opacity: 0.65; }

                Text { text: I18n.t("FC22 · 掩码写寄存器", "FC22 · Mask Write Register"); font-weight: 700; }
                Field { label: I18n.t("地址：", "Address:"); SpinBox { value <=> root.mw-addr; minimum: 0; maximum: 65535; } }
                Field { label: "AND (hex):"; LineEdit { text <=> root.mw-and; placeholder-text: "FFFF"; } }
                Field { label: "OR (hex):"; LineEdit { text <=> root.mw-or; placeholder-text: "0000"; } }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } AccentButton { text: I18n.t("发送 FC22", "Send FC22"); width: 110px; clicked => { root.master-mask-write(); } } }

                Rectangle { height: 1px; background: ProductDesign.border; }

                Text { text: I18n.t("FC23 · 读写多个寄存器", "FC23 · Read/Write Multiple Registers"); font-weight: 700; }
                HorizontalLayout {
                    spacing: 10px;
                    Field { label: I18n.t("读取地址：", "Read addr:"); SpinBox { value <=> root.rw-read-addr; minimum: 0; maximum: 65535; } }
                    Field { label: I18n.t("读取数量：", "Read qty:"); SpinBox { value <=> root.rw-read-qty; minimum: 1; maximum: 125; } }
                }
                Field { label: I18n.t("写入地址：", "Write addr:"); SpinBox { value <=> root.rw-write-addr; minimum: 0; maximum: 65535; } }
                Field { label: I18n.t("写入数值：", "Write vals:"); LineEdit { text <=> root.rw-write-vals; placeholder-text: "1 2 3 0x10"; } }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } AccentButton { text: I18n.t("发送 FC23", "Send FC23"); width: 110px; clicked => { root.master-read-write(); } } }

                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } ProductButton { text: I18n.t("关闭", "Close"); clicked => { root.adv-open = false; } } }
            }
        }
    }

    // =====================================================================
    // Per-cell format dialog
    // =====================================================================
    ProductModal {
        open: root.cf-open;
        close-requested => { root.cf-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 420px;
            dialog-height: 230px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("寄存器 @", "Register @") + root.cf-addr + I18n.t(" 格式", " format"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("格式：", "Format:"); ComboBox { model: Fmt.list; current-index <=> root.cf-fmt; } }
                Text { text: I18n.t("仅应用到此寄存器；32/64 位格式占用后续寄存器。", "Applies to this register only; 32/64-bit spans the following registers."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    ProductButton { text: I18n.t("恢复默认", "Use default"); clicked => { if (root.active-mode == 0) { root.master-cell-format-clear(); } else { root.slave-cell-format-clear(); } root.cf-open = false; } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.cf-open = false; } }
                    AccentButton { text: I18n.t("应用", "Apply"); width: 90px; clicked => { if (root.active-mode == 0) { root.master-cell-format(); } else { root.slave-cell-format(); } root.cf-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Derived channels dialog
    // =====================================================================
    ProductModal {
        open: root.dv-open;
        close-requested => { root.dv-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 480px;
            dialog-height: 420px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("计算通道", "Derived channels"); font-size: 17px; font-weight: 800; }
                Text {
                    text: I18n.t("每行输入“名称 = 公式”，用 r0、r1 等引用轮询寄存器；支持 + - * / % & | ^ << >> 和括号。", "One \"name = formula\" per line. Use r0, r1, … for polled registers; + - * / % & | ^ << >> and ( ) are supported.");
                    wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65;
                }
                TextEdit { vertical-stretch: 1; text <=> root.dv-text; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.dv-open = false; } }
                    AccentButton { text: I18n.t("应用", "Apply"); width: 90px; clicked => { root.master-derived(); root.dv-open = false; } }
                }
            }
        }
    }

    // ---- View options dialog ----
    ProductModal {
        open: root.vw-open;
        close-requested => { root.vw-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 420px;
            dialog-height: 300px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: I18n.t("显示设置", "View options"); font-size: 17px; font-weight: 800; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("地址格式", "Address format"); vertical-alignment: center; width: 130px; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: ["Decimal", "Hex", "PLC (base-1)"];
                        current-index <=> root.addr-mode;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("数值单元格内显示地址", "Address in value cell"); vertical-alignment: center; width: 130px; }
                    CheckBox { checked <=> root.addr-in-cell; }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("字号", "Font size"); vertical-alignment: center; width: 130px; }
                    ProductButton { text: "A−"; clicked => { if root.grid-font > 10px { root.grid-font -= 1px; } } }
                    Text { text: "\{round(root.grid-font / 1px)} px"; vertical-alignment: center; }
                    ProductButton { text: "A+"; clicked => { if root.grid-font < 22px { root.grid-font += 1px; } } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    AccentButton { text: I18n.t("关闭", "Close"); width: 90px; clicked => { root.vw-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Scan dialog
    // =====================================================================
    ProductModal {
        open: root.scan-open;
        close-requested => { root.scan-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 560px;
            dialog-height: 560px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: I18n.t("扫描", "Scan"); font-size: 17px; font-weight: 800; }
                Text { text: I18n.t("使用主站连接设置；使用同一串口时请先停止轮询。", "Uses the Master connection settings. Stop polling first if on the same serial port."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.6; }
                Field { label: I18n.t("类型：", "Type:"); ComboBox { model: [I18n.t("地址扫描", "Address Scan"), I18n.t("从站 ID 扫描", "Slave ID Scan")]; current-index <=> root.sc-type; } }
                Field { label: I18n.t("功能码：", "Function:"); ComboBox { model: [I18n.t("0x 读线圈", "0x Read Coils"), I18n.t("1x 读离散输入", "1x Read Discrete Inputs"), I18n.t("4x 读保持寄存器", "4x Read Holding Registers"), I18n.t("3x 读输入寄存器", "3x Read Input Registers")]; current-index <=> root.sc-func; } }
                if root.sc-type == 0: Field { label: I18n.t("起始：", "Start:"); SpinBox { value <=> root.sc-start; minimum: 0; maximum: 65535; } }
                if root.sc-type == 0: Field { label: I18n.t("数量：", "Count:"); SpinBox { value <=> root.sc-count; minimum: 1; maximum: 2000; } }
                if root.sc-type == 1: Field { label: I18n.t("探测地址：", "Probe addr:"); SpinBox { value <=> root.sc-addr; minimum: 0; maximum: 65535; } }
                if root.sc-type == 1: Field { label: I18n.t("起始 ID：", "From ID:"); SpinBox { value <=> root.sc-fromid; minimum: 0; maximum: 247; } }
                if root.sc-type == 1: Field { label: I18n.t("结束 ID：", "To ID:"); SpinBox { value <=> root.sc-toid; minimum: 0; maximum: 247; } }
                HorizontalLayout {
                    spacing: 10px;
                    AccentButton { text: I18n.t("启动", "Start"); width: 90px; clicked => { root.sc-type == 0 ? root.master-scan-address() : root.master-scan-slave(); } }
                    ProductButton { text: I18n.t("停止", "Stop"); clicked => { root.master-scan-stop(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("关闭", "Close"); clicked => { root.scan-open = false; } }
                }
                Text { text: root.scan-status; opacity: 0.8; }
                LogPanel { vertical-stretch: 1; lines: root.scan-rows; }
            }
        }
    }

    // =====================================================================
    // Scaling dialog
    // =====================================================================
    ProductModal {
        open: root.scl-open;
        close-requested => { root.scl-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 460px;
            dialog-height: 380px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("线性换算", "Scaling (linear)"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("启用：", "Enabled:"); CheckBox { checked <=> root.scl-enabled; } }
                Field { label: I18n.t("原始值 X1：", "Raw X1:"); LineEdit { text <=> root.scl-x1; } }
                Field { label: I18n.t("物理值 Y1：", "Eng Y1:"); LineEdit { text <=> root.scl-y1; } }
                Field { label: I18n.t("原始值 X2：", "Raw X2:"); LineEdit { text <=> root.scl-x2; } }
                Field { label: I18n.t("物理值 Y2：", "Eng Y2:"); LineEdit { text <=> root.scl-y2; } }
                Field { label: I18n.t("小数位：", "Decimals:"); SpinBox { value <=> root.scl-decimals; minimum: 0; maximum: 6; } }
                Text { text: I18n.t("Y = m·(X − X1) + Y1，适用于数值寄存器格式。", "Y = m·(X − X1) + Y1.  Applies to numeric register formats."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.scl-open = false; } }
                    AccentButton { text: I18n.t("应用", "Apply"); width: 90px; clicked => { root.active-mode == 0 ? root.master-scaling() : root.slave-scaling(); root.scl-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Colors dialog
    // =====================================================================
    ProductModal {
        open: root.col-open;
        close-requested => { root.col-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 540px;
            dialog-height: 360px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("条件颜色", "Conditional colours"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("默认：", "Normal:"); ComboBox { model: Fmt.palette; current-index <=> root.col-normal; } }
                Field { label: I18n.t("规则 1：", "Rule 1:"); HorizontalLayout { spacing: 6px;
                    ComboBox { width: 90px; model: Fmt.ops; current-index <=> root.col-op1; }
                    LineEdit { width: 110px; text <=> root.col-v1; placeholder-text: I18n.t("数值", "value"); }
                    ComboBox { model: Fmt.palette; current-index <=> root.col-c1; }
                } }
                Field { label: I18n.t("规则 2：", "Rule 2:"); HorizontalLayout { spacing: 6px;
                    ComboBox { width: 90px; model: Fmt.ops; current-index <=> root.col-op2; }
                    LineEdit { width: 110px; text <=> root.col-v2; placeholder-text: I18n.t("数值", "value"); }
                    ComboBox { model: Fmt.palette; current-index <=> root.col-c2; }
                } }
                Text { text: I18n.t("规则 1 优先；AND 按位掩码处理数值（支持十六进制和十进制）。", "Rule 1 takes precedence. AND treats the value as a bitmask (hex/decimal)."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    ProductButton { text: I18n.t("清除", "Clear"); clicked => { root.col-op1 = 0; root.col-op2 = 0; root.col-normal = 0; root.active-mode == 0 ? root.master-colors() : root.slave-colors(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.col-open = false; } }
                    AccentButton { text: I18n.t("应用", "Apply"); width: 90px; clicked => { root.active-mode == 0 ? root.master-colors() : root.slave-colors(); root.col-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Value-names dialog
    // =====================================================================
    ProductModal {
        open: root.vn-open;
        close-requested => { root.vn-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 480px;
            dialog-height: 480px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("数值标签", "Value names"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("启用：", "Enabled:"); CheckBox { text: I18n.t("使用标签代替数值显示", "show labels instead of numeric values"); checked <=> root.vn-enabled; } }
                Text { text: I18n.t("每行输入“数值=名称”，支持十进制或 0x 十六进制；未映射的值仍显示数值。", "One \"value=name\" per line (decimal or 0x hex). Unmapped values stay numeric."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.vn-text;
                }
                HorizontalLayout {
                    spacing: 10px;
                    ProductButton { text: I18n.t("导入…", "Import…"); clicked => { root.vn-import(); } }
                    ProductButton { text: I18n.t("导出…", "Export…"); clicked => { root.vn-export(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("取消", "Cancel"); clicked => { root.vn-open = false; } }
                    AccentButton { text: I18n.t("应用", "Apply"); width: 90px; clicked => { root.active-mode == 0 ? root.master-value-names() : root.slave-value-names(); root.vn-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Logging dialog
    // =====================================================================
    ProductModal {
        open: root.log-open;
        close-requested => { root.log-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 480px;
            dialog-height: 400px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("数据记录（当前窗口）", "Data logging (active window)"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("状态：", "Status:"); Text {
                    text: root.log-active ? I18n.t("记录中…", "Logging…") : I18n.t("已停止", "Stopped");
                    vertical-alignment: center;
                    color: root.log-active ? Theme.ok : ProductDesign.text;
                    font-weight: 700;
                } }
                Field { label: I18n.t("记录频率：", "Rate:"); ComboBox { model: [I18n.t("每次读取", "Each read"), I18n.t("每隔 N 秒", "Every N seconds")]; current-index <=> root.log-rate-mode; } }
                if root.log-rate-mode == 1: Field { label: I18n.t("周期(秒)：", "Period s:"); SpinBox { value <=> root.log-period; minimum: 1; maximum: 86400; } }
                Field { label: I18n.t("分隔符：", "Delimiter:"); ComboBox { model: [I18n.t("逗号 (CSV)", "Comma (CSV)"), I18n.t("制表符", "Tab")]; current-index <=> root.log-delim; } }
                Field { label: I18n.t("变化记录：", "On change:"); CheckBox { text: I18n.t("仅当数值变化时记录", "log only when a value changes"); checked <=> root.log-onchange; } }
                Field { label: I18n.t("时间戳：", "Timestamp:"); CheckBox { text: I18n.t("每行添加日期和时间", "prefix each row with date/time"); checked <=> root.log-timestamp; } }
                Text { text: I18n.t("点击开始后选择文件；当前窗口轮询时实时追加记录。", "Start choose a file; rows are appended live as the active window polls."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    AccentButton { text: I18n.t("开始记录…", "Start logging…"); width: 130px; enabled: !root.log-active; clicked => { root.master-start-log(); } }
                    ProductButton { text: I18n.t("停止", "Stop"); enabled: root.log-active; clicked => { root.master-stop-log(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("关闭", "Close"); clicked => { root.log-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Simulation dialog (slave)
    // =====================================================================
    ProductModal {
        open: root.sim-open;
        close-requested => { root.sim-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 460px;
            dialog-height: 480px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("寄存器仿真", "Register simulation"); font-size: 17px; font-weight: 800; }
                Field { label: I18n.t("状态：", "Status:"); Text {
                    text: root.sim-active ? I18n.t("运行中", "Running") : I18n.t("已停止", "Stopped");
                    vertical-alignment: center;
                    color: root.sim-active ? Theme.ok : ProductDesign.text;
                    font-weight: 700;
                } }
                Field { label: I18n.t("模式：", "Mode:"); ComboBox { model: [I18n.t("关闭", "Off"), I18n.t("递增", "Increment"), I18n.t("递减", "Decrement"), I18n.t("随机", "Random"), I18n.t("翻转", "Toggle")]; current-index <=> root.sim-mode; } }
                Field { label: I18n.t("步长：", "Step:"); SpinBox { value <=> root.sim-step; minimum: 1; maximum: 65535; } }
                Field { label: I18n.t("最小值：", "Min:"); SpinBox { value <=> root.sim-min; minimum: -32768; maximum: 65535; } }
                Field { label: I18n.t("最大值：", "Max:"); SpinBox { value <=> root.sim-max; minimum: -32768; maximum: 65535; } }
                Field { label: I18n.t("间隔(ms)：", "Interval ms:"); SpinBox { value <=> root.sim-interval; minimum: 50; maximum: 60000; step-size: 50; } }
                Field { label: I18n.t("范围：", "Scope:"); CheckBox { text: I18n.t("仅一个寄存器", "Only one register"); checked <=> root.sim-one; } }
                Field { label: I18n.t("目标地址：", "Target addr:"); SpinBox { value <=> root.sim-target; minimum: 0; maximum: 65535; enabled: root.sim-one; } }
                Text { text: I18n.t("按当前表格的地址和数量动态更新寄存器；可限定为单个寄存器。主站可以实时读取变化后的值。", "Animates the current table/address/quantity shown in the grid (or just one register if scoped). Masters read the changing values live."); wrap: word-wrap; font-size: ProductDesign.font-sm; opacity: 0.65; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    AccentButton { text: I18n.t("启动", "Start"); width: 90px; enabled: !root.sim-active; clicked => { root.slave-sim-start(); } }
                    ProductButton { text: I18n.t("停止", "Stop"); enabled: root.sim-active; clicked => { root.slave-sim-stop(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ProductButton { text: I18n.t("关闭", "Close"); clicked => { root.sim-open = false; } }
                }
            }
        }
    }

    // =====================================================================
    // Connection info popup (status bar click)
    // =====================================================================
    ProductModal {
        open: root.conn-info-open;
        close-requested => { root.conn-info-open = false; }
        width: 100%;
        height: 100%;
        TouchArea { width: 100%; height: 100%; clicked => { root.conn-info-open = false; } }
        ProductDialogSurface {
            available-width: parent.width; available-height: parent.height;
            dialog-width: 420px;
            dialog-height: 260px;
            background: ProductDesign.surface;
            border-width: 1px;
            border-color: ProductDesign.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: I18n.t("连接详情", "Connection details"); font-size: 17px; font-weight: 800; }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.conn-info-text;
                    read-only: true;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
